@using Ecommerce.Application.DTOs.ModelsRequest.Address
@model CreateAddressRequest
@{
    ViewData["Title"] = "Thêm địa chỉ mới";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Thêm địa chỉ mới</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="Street" class="form-label">Đường</label>
                            <input asp-for="Street" class="form-control" placeholder="Nhập tên đường" />
                            <span asp-validation-for="Street" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Ward" class="form-label">Phường/Xã</label>
                            <input asp-for="Ward" class="form-control" placeholder="Nhập phường/xã" />
                            <span asp-validation-for="Ward" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="District" class="form-label">Quận/Huyện</label>
                            <input asp-for="District" class="form-control" placeholder="Nhập quận/huyện" />
                            <span asp-validation-for="District" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="City" class="form-label">Thành phố</label>
                            <input asp-for="City" class="form-control" placeholder="Nhập thành phố" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Province" class="form-label">Tỉnh</label>
                            <input asp-for="Province" class="form-control" placeholder="Nhập tỉnh" />
                        </div>
                        <div class="mb-3 form-check">
                            <input asp-for="IsDefault" class="form-check-input" />
                            <label asp-for="IsDefault" class="form-check-label">Đặt làm địa chỉ mặc định</label>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-dark">
                                <i class="fas fa-save me-1"></i>Lưu
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
