@using Ecommerce.Web.Models
@model UserAddressViewModel
@{
    ViewData["Title"] = "Xóa địa chỉ";
}

@section Styles {
    <style>
        .address-page {
            background: radial-gradient(1200px 400px at 15% -50px, rgba(99,102,241,.07), transparent),
                        radial-gradient(1000px 400px at 90% -100px, rgba(239,68,68,.05), transparent),
                        #f6f7f9;
            min-height: calc(100vh - 76px);
        }

        .page-head {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.75rem;
        }

        .back-btn {
            width: 44px;
            height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111827;
        }

        .title-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            color: #fff;
            box-shadow: 0 6px 14px rgba(17,24,39,.25);
        }

        .ui-card {
            background: #fff;
            border: 1px solid #eef0f3;
            border-radius: 18px;
            box-shadow: 0 2px 10px rgba(17,24,39,.04);
            overflow: hidden;
        }

        .ui-card-head {
            background: linear-gradient(135deg, #7f1d1d, #991b1b);
            color: #fff;
            padding: 1.25rem 1.6rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        .ui-card-body {
            padding: 1.8rem 1.6rem;
        }

        .info-box {
            background: #f8fafc;
            border: 1px solid #eef0f3;
            border-radius: 14px;
            padding: 1.1rem 1.2rem;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            padding: .4rem 0;
            font-size: .9rem;
        }

        .info-row .k {
            color: #6b7280;
            flex-shrink: 0;
        }

        .info-row .v {
            color: #111827;
            font-weight: 600;
            text-align: right;
        }

        .badge-default {
            background: #312e81;
            color: #fff;
            font-size: .7rem;
            font-weight: 600;
            border-radius: 20px;
            padding: .3rem .7rem;
        }
    </style>
}

<div class="address-page">
    <div class="container py-5">

        <!-- Header -->
        <div class="page-head">
            <a asp-action="Index" class="btn btn-outline-dark rounded-circle back-btn" title="Quay lại">
                <i class="fas fa-arrow-left"></i>
            </a>
            <span class="title-icon bg-dark"><i class="fas fa-trash-alt"></i></span>
            <div>
                <h1 class="page-title mb-1">Xóa địa chỉ</h1>
                <p class="text-muted mb-0">Xác nhận xóa địa chỉ giao hàng này</p>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="ui-card">
                    <div class="ui-card-head">
                        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Xác nhận xóa</h5>
                    </div>
                    <div class="ui-card-body">
                        <p class="text-muted mb-3">Bạn có chắc chắn muốn xóa địa chỉ này? Hành động này không thể hoàn tác.</p>

                        <div class="info-box mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-danger"><i class="fas fa-map-marker-alt me-1"></i>Thông tin địa chỉ</span>
                                @if (Model.IsDefault)
                                {
                                    <span class="badge-default"><i class="fas fa-check me-1"></i>Mặc định</span>
                                }
                            </div>
                            <div class="info-row">
                                <span class="k">Đường</span>
                                <span class="v">@Model.Street</span>
                            </div>
                            <div class="info-row">
                                <span class="k">Phường/Xã</span>
                                <span class="v">@Model.Ward</span>
                            </div>
                            <div class="info-row">
                                <span class="k">Quận/Huyện</span>
                                <span class="v">@Model.District</span>
                            </div>
                            <div class="info-row">
                                <span class="k">Thành phố</span>
                                <span class="v">@Model.City</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Province))
                            {
                                <div class="info-row">
                                    <span class="k">Tỉnh</span>
                                    <span class="v">@Model.Province</span>
                                </div>
                            }
                        </div>

                        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                    <i class="fas fa-arrow-left me-2"></i>Quay lại
                                </a>
                                <button type="submit" class="btn btn-danger rounded-pill px-5">
                                    <i class="fas fa-trash me-2"></i>Xóa địa chỉ
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>