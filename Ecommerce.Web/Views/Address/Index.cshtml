@using Ecommerce.Web.Models
@model IReadOnlyList<UserAddressViewModel>
@{
    ViewData["Title"] = "Địa chỉ của tôi";
}

@section Styles {
    <style>
        .address-page {
            background: radial-gradient(1200px 400px at 15% -50px, rgba(99,102,241,.07), transparent),
                        radial-gradient(1000px 400px at 90% -100px, rgba(239,68,68,.05), transparent),
                        #f6f7f9;
            min-height: calc(100vh - 76px);
        }

        .page-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.75rem;
        }

        .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111827;
        }

        .title-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            color: #fff;
            box-shadow: 0 6px 14px rgba(17,24,39,.25);
        }

        .btn-dark-soft {
            background: #111827;
            color: #fff;
            font-weight: 600;
            border: none;
            border-radius: 20px;
        }

        .btn-dark-soft:hover {
            background: #312e81;
            color: #fff;
            box-shadow: 0 6px 14px rgba(17,24,39,.25);
        }

        .address-card {
            background: #fff;
            border: 1px solid #eef0f3;
            border-radius: 16px;
            box-shadow: 0 2px 10px rgba(17,24,39,.04);
            padding: 1.25rem 1.35rem;
            height: 100%;
            transition: transform .25s, box-shadow .25s;
        }

        .address-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(17,24,39,.12);
        }

        .address-card.default {
            border-color: #312e81;
            border-width: 1.5px;
            box-shadow: 0 0 0 2px rgba(49,46,129,.12), 0 10px 24px rgba(17,24,39,.08);
        }

        .address-icon {
            width: 46px;
            height: 46px;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eef2ff;
            color: #3730a3;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .address-street {
            font-weight: 700;
            color: #111827;
            font-size: .98rem;
        }

        .address-line {
            color: #6b7280;
            font-size: .88rem;
            line-height: 1.7;
        }

        .badge-default {
            background: #312e81;
            color: #fff;
            font-size: .7rem;
            font-weight: 600;
            border-radius: 20px;
            padding: .3rem .7rem;
        }

        .card-divider {
            border-top: 1px solid #eef0f3;
        }

        .btn-action {
            border: 1.5px solid #e5e7eb;
            color: #374151;
            border-radius: 10px;
            font-size: .8rem;
            font-weight: 600;
            padding: .42rem .9rem;
        }

        .btn-action:hover {
            border-color: #111827;
            color: #111827;
            background: #f8fafc;
        }

        .btn-action.success:hover {
            border-color: #10b981;
            color: #10b981;
        }

        .btn-action.danger:hover {
            border-color: #dc2626;
            color: #dc2626;
        }

        .empty-state {
            background: #fff;
            border: 1px dashed #d1d5db;
            border-radius: 20px;
        }

        .empty-icon {
            width: 84px;
            height: 84px;
            margin: 0 auto 1.25rem;
            border-radius: 50%;
            background: #f3f4f6;
            color: #9ca3af;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
        }
    </style>
}

<div class="address-page">
    <div class="container py-5">

        <!-- Header -->
        <div class="page-head">
            <div class="d-flex align-items-center gap-3">
                <span class="title-icon bg-dark"><i class="fas fa-map-marker-alt"></i></span>
                <div>
                    <h1 class="page-title mb-1">Địa chỉ của tôi</h1>
                    <p class="text-muted mb-0">Quản lý thông tin địa chỉ giao hàng của bạn</p>
                </div>
            </div>
            <a asp-action="Create" class="btn btn-dark-soft px-4 py-2">
                <i class="fas fa-plus me-2"></i>Thêm địa chỉ mới
            </a>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="empty-state text-center py-5">
                <div class="empty-icon"><i class="fas fa-map-marked-alt"></i></div>
                <h4 class="mb-1">Bạn chưa có địa chỉ nào</h4>
                <p class="text-muted mb-3">Thêm địa chỉ để nhận hàng nhanh chóng và thuận tiện hơn</p>
                <a asp-action="Create" class="btn btn-dark-soft rounded-pill px-4">
                    <i class="fas fa-plus me-2"></i>Thêm địa chỉ mới
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var addr in Model)
                {
                    <div class="col-md-6">
                        <div class="address-card @(addr.IsDefault ? "default" : "")">
                            <div class="d-flex align-items-start gap-3">
                                <span class="address-icon">
                                    <i class="fas @(addr.IsDefault ? "fa-check-circle" : "fa-home")"></i>
                                </span>
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                                        <span class="address-street">@addr.Street, @addr.Ward</span>
                                        @if (addr.IsDefault)
                                        {
                                            <span class="badge-default"><i class="fas fa-check me-1"></i>Mặc định</span>
                                        }
                                    </div>
                                    <div class="address-line">
                                        @addr.Street, @addr.Ward, @addr.District, @addr.Province, @addr.City
                                    </div>
                                    <div class="card-divider d-flex flex-wrap gap-2 mt-3 pt-3">
                                        @if (!addr.IsDefault)
                                        {
                                            <form asp-action="SetDefault" asp-route-id="@addr.Id" method="post" class="m-0">
                                                <button type="submit" class="btn btn-action success">
                                                    <i class="fas fa-check-circle me-1"></i>Mặc định
                                                </button>
                                            </form>
                                        }
                                        <a asp-action="Edit" asp-route-id="@addr.Id" class="btn btn-action">
                                            <i class="fas fa-edit me-1"></i>Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@addr.Id" class="btn btn-action danger">
                                            <i class="fas fa-trash me-1"></i>Xóa
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>