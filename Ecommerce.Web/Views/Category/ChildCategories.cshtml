@using Ecommerce.Application.DTOs.Models
@using Ecommerce.Domain.Shared
@model IReadOnlyList<CategoryViewModel>

@{
    ViewData["Title"] = "Danh mục sản phẩm";
    var parentId = ViewBag.ParentCategoryId as int?;
    var selectedCategoryId = ViewBag.SelectedCategoryId as int?;
    var totalProducts = (int)(ViewBag.TotalProducts ?? 0);
    var selectedCategory = Model?.FirstOrDefault(c => c.Id == selectedCategoryId);
}

@functions {
    string GetCategoryIcon(string name)
    {
        return name.ToLower() switch
        {
            "iphone" => "fab fa-apple",
            "apple" => "fab fa-apple",
            "samsung" => "fas fa-mobile-alt",
            "xiaomi" => "fas fa-mobile-alt",
            "oppo" => "fas fa-mobile-alt",
            "vivo" => "fas fa-mobile-alt",
            "realme" => "fas fa-mobile-alt",
            "laptop" => "fas fa-laptop",
            "máy tính" => "fas fa-desktop",
            "điện thoại" => "fas fa-mobile-alt",
            "smartphone" => "fas fa-mobile-alt",
            "tablet" => "fas fa-tablet-alt",
            "tai nghe" => "fas fa-headphones",
            "headphone" => "fas fa-headphones",
            "bàn phím" => "fas fa-keyboard",
            "keyboard" => "fas fa-keyboard",
            "chuột" => "fas fa-mouse",
            _ => "fas fa-box"
        };
    }
}

<div class="app-page">
    <div class="container py-5">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Home")"><i class="fas fa-home me-1"></i>Trang chủ</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Category")">Danh mục</a>
                </li>
                <li class="breadcrumb-item active">
                    @(selectedCategory != null ? selectedCategory.Name : "Tất cả danh mục")
                </li>
            </ol>
        </nav>

        <!-- Tiêu đề -->
        <div class="page-head mb-4">
            <div class="d-flex align-items-center gap-3">
                <a href="@Url.Action("Index", "Category")" class="btn btn-outline-dark rounded-circle back-btn" title="Quay lại">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="page-title mb-1">@(selectedCategory != null ? selectedCategory.Name : "Danh mục sản phẩm")</h1>
                    <p class="text-muted mb-0">Chọn một danh mục con để xem sản phẩm</p>
                </div>
            </div>
            <span class="badge bg-dark fs-6 rounded-pill px-3 py-2">
                <i class="fas fa-box me-1"></i>@totalProducts sản phẩm
            </span>
        </div>

        <!-- Danh mục con -->
        @if (Model != null && Model.Any())
        {
            <div class="row g-3 g-md-4 mb-5">
                @foreach (var category in Model)
                {
                    var isSelected = category.Id == selectedCategoryId;
                    <div class="col-6 col-md-3 col-lg-2">
                        <a href="@Url.Action("ChildCategories", "Category", new { id = parentId, selectedCategoryId = category.Id })"
                           class="child-card @(isSelected ? "selected" : "")">
                            <span class="child-icon"><i class="@GetCategoryIcon(category.Name!)"></i></span>
                            <span class="child-name">@category.Name</span>
                            <span class="child-count">
                                <i class="fas fa-box me-1"></i>@(category.Products?.Count ?? 0) sản phẩm
                            </span>
                            <span class="child-check"><i class="fas fa-check"></i></span>
                        </a>
                    </div>
                }
            </div>
        }

        <!-- Sản phẩm -->
        <div class="section-head mb-3">
            <h2 class="section-title mb-0">
                <span class="title-icon bg-dark"><i class="fas fa-shopping-bag"></i></span>
                @if (selectedCategoryId.HasValue && selectedCategory != null)
                {
                    <span>@selectedCategory.Name</span>
                }
                else
                {
                    <span>Tất cả sản phẩm</span>
                }
            </h2>
            <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                @totalProducts sản phẩm
            </span>
        </div>

        @{
            var allProducts = new List<ProductViewModel>();
            if (Model != null)
            {
                allProducts = (selectedCategoryId.HasValue && selectedCategory != null)
                    ? (selectedCategory.Products ?? new List<ProductViewModel>()).ToList()
                    : Model.SelectMany(c => c.Products ?? new List<ProductViewModel>()).ToList();
            }
        }

        @if (allProducts.Any())
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @foreach (var product in allProducts)
                {
                    <div class="col">
                        <div class="product-card">
                            <a href="@Url.Action("Detail", "Product", new { id = product.Id })" class="product-link">
                                <div class="product-img">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name">
                                    }
                                    else
                                    {
                                        <div class="product-img-placeholder">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                </div>
                                <div class="product-info">
                                    <h6 class="product-title">@product.Name</h6>
                                    @if (product.Price > 0)
                                    {
                                        <div class="product-price">@product.Price.ToString("N0") đ</div>
                                    }
                                    else
                                    {
                                        <div class="product-price price-none">Liên hệ</div>
                                    }
                                </div>
                            </a>
                            <div class="product-actions">
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    <input type="hidden" name="Id" value="@product.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-add-cart w-100">
                                        <i class="fas fa-cart-plus me-2"></i>Thêm vào giỏ
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state text-center py-5">
                <div class="empty-icon"><i class="fas fa-box-open"></i></div>
                <h4 class="mb-1">Chưa có sản phẩm nào</h4>
                <p class="text-muted mb-3">Danh mục này hiện chưa có sản phẩm</p>
                <a href="@Url.Action("Index", "Category")" class="btn btn-dark-soft rounded-pill px-4">
                    <i class="fas fa-th-large me-2"></i>Xem danh mục khác
                </a>
            </div>
        }
    </div>
</div>