@using Ecommerce.WebApi.ViewModels.AuthView
@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    ViewData["HideAuthHeader"] = true;
    ViewData["HideFooter"] = true;
}

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">

                <div class="card auth-card">
                    <div class="card-header">
                        <div class="brand-icon">
                            <i class="fas fa-store"></i>
                        </div>
                        <h2>Tạo tài khoản</h2>
                        <p>Tham gia cùng chúng tôi</p>
                    </div>
                    <div class="card-body">
                        <form asp-action="Register" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="form-floating">
                                <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                                <label asp-for="FullName">Họ và tên</label>
                                <i class="fas fa-user input-icon"></i>
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>

                            <div class="form-floating">
                                <input asp-for="Email" class="form-control" placeholder="email@example.com" />
                                <label asp-for="Email">Email</label>
                                <i class="fas fa-envelope input-icon"></i>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="form-floating">
                                <input asp-for="Password" class="form-control" placeholder="Ít nhất 6 ký tự" />
                                <label asp-for="Password">Mật khẩu</label>
                                <i class="fas fa-lock input-icon"></i>
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="form-floating">
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" />
                                <label asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                                <i class="fas fa-check-circle input-icon"></i>
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                            <button type="submit" class="auth-btn mt-2">
                                <i class="fas fa-user-plus me-2"></i>Đăng ký
                            </button>
                        </form>

                        <div class="auth-links">
                            Đã có tài khoản? <a asp-action="Login">Đăng nhập</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}