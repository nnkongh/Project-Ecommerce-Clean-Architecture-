@{
    ViewData["Title"] = "Xác nhận quên mật khẩu";
    ViewData["HideAuthHeader"] = true;
    ViewData["HideFooter"] = true;
}

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="card auth-card">
                    <div class="card-header">
                        <div class="brand-icon">
                            <i class="fas fa-envelope-open-text"></i>
                        </div>
                        <h2>@ViewData["Title"]</h2>
                        <p>Kiểm tra email của bạn</p>
                    </div>
                    <div class="card-body text-center">
                        <p class="mb-3">
                            Chúng tôi đã gửi link đặt lại mật khẩu đến email của bạn.
                        </p>
                        <p class="text-muted small mb-4">
                            Vui lòng kiểm tra hộp thư và làm theo hướng dẫn.
                            Nếu không thấy email, hãy kiểm tra thư mục spam.
                        </p>
                        <a asp-action="Login" class="auth-btn">
                            <i class="fas fa-sign-in-alt me-2"></i>Quay lại đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}
