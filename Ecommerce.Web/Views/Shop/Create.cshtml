@model ShopRegisterViewModel

@{
    ViewData["Title"] = "Cửa hàng của tôi";
}

@section Styles {
    <style>
        .register-icon {
            width: 84px;
            height: 84px;
            margin: 0 auto 1.25rem;
            border-radius: 50%;
            background: #eef2ff;
            color: #3730a3;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
        }

        /* Info rows */
        .info-item {
            display: flex;
            align-items: center;
            gap: .9rem;
            padding: .9rem 1.1rem;
            border-radius: 14px;
            background: #f8fafc;
            border: 1px solid #eef0f3;
        }

        .info-icon {
            width: 40px;
            height: 40px;
            border-radius: 11px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eef2ff;
            color: #3730a3;
            font-size: .95rem;
            flex-shrink: 0;
        }
    </style>
}

<div class="app-page">
    <div class="container py-5">

        <!-- Header -->
        <div class="page-head">
            <div class="d-flex align-items-center gap-3">
                <span class="title-icon bg-dark"><i class="fas fa-store"></i></span>
                <div>
                    <h1 class="page-title mb-1">Cửa hàng của tôi</h1>
                    <p class="text-muted mb-0">Quản lý cửa hàng và sản phẩm của bạn</p>
                </div>
            </div>
            @if (Model.Shop?.HasShop == true)
            {
                <span class="status-pill bg-success text-white">
                    <i class="fas fa-check-circle"></i>Đang hoạt động
                </span>
            }
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10">

                @if (Model.Shop?.HasShop != true)
                {
                    <!-- ========== ĐĂNG KÝ CỬA HÀNG ========== -->
                    <div class="ui-card">
                        <div class="ui-card-head">
                            <h5 class="mb-0">
                                <i class="fas fa-plus-circle me-2"></i>Đăng ký cửa hàng
                            </h5>
                        </div>
                        <div class="ui-card-body">
                            <div class="text-center mb-4">
                                <div class="register-icon"><i class="fas fa-store"></i></div>
                                <h5>Bạn chưa có cửa hàng</h5>
                                <p class="text-muted">Tạo cửa hàng để bắt đầu bán sản phẩm trên nền tảng</p>
                            </div>

                            <form asp-action="Create" method="post">
                                <div class="row justify-content-center">
                                    <div class="col-md-8">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fas fa-tag me-1"></i>Tên cửa hàng <span class="text-danger">*</span>
                                            </label>
                                            <input type="text"
                                                   name="shopName"
                                                   class="form-control form-control-lg"
                                                   placeholder="Nhập tên cửa hàng của bạn"
                                                   required />
                                            <div class="form-text">Tên cửa hàng sẽ hiển thị công khai với khách hàng</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="text-center mt-3">
                                    <button type="submit" class="btn btn-dark-soft btn-lg rounded-pill px-5">
                                        <i class="fas fa-rocket me-2"></i>Tạo cửa hàng ngay
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <!-- ========== THÔNG TIN CỬA HÀNG ========== -->
                    <div class="ui-card mb-4">
                        <div class="ui-card-head d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fas fa-store me-2"></i>@Model.Shop!.Name
                            </h5>
                            <span class="status-pill bg-white text-success">
                                <i class="fas fa-check me-1"></i>Đã đăng ký
                            </span>
                        </div>
                        <div class="ui-card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="info-item">
                                        <span class="info-icon"><i class="fas fa-calendar-alt"></i></span>
                                        <div>
                                            <div class="text-muted small">Ngày tạo</div>
                                            <div class="fw-semibold">@Model.Shop.CreatedAt.ToString("dd/MM/yyyy")</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="info-item">
                                        <span class="info-icon"><i class="fas fa-toggle-on"></i></span>
                                        <div>
                                            <div class="text-muted small">Trạng thái</div>
                                            <span class="badge bg-success rounded-pill">Hoạt động</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========== NÚT THÊM / XEM SẢN PHẨM ========== -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <button type="button" class="btn btn-dark-soft btn-lg w-100 py-3" onclick="toogleProductForm()">
                                <i class="fas fa-plus-circle me-2"></i>Thêm sản phẩm
                            </button>
                        </div>
                        <div class="col-md-6">
                            <a asp-action="Products" class="btn btn-outline-dark-soft btn-lg w-100 py-3">
                                <i class="fas fa-box-open me-2"></i>Xem danh sách sản phẩm
                            </a>
                        </div>
                    </div>

                    <div id="productFormSection" style="display: none;">
                        <div class="divider">
                            <span><i class="fas fa-box me-1"></i>Thêm sản phẩm mới</span>
                        </div>

                        <!-- ========== FORM THÊM SẢN PHẨM ========== -->
                        <div class="ui-card">
                            <div class="ui-card-head d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="fas fa-plus-circle me-2"></i>Thêm sản phẩm vào cửa hàng
                                </h5>
                            </div>
                            <div class="ui-card-body">
                                <form asp-action="AddProduct" method="post" enctype="multipart/form-data">
                                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                    <!-- Upload hình ảnh -->
                                    <div class="form-section">
                                        <div class="form-section-title"><i class="fas fa-image me-1"></i>Hình ảnh sản phẩm</div>
                                        <div class="row align-items-center g-3">
                                            <div class="col-md-6">
                                                <label asp-for="NewProduct.Image" class="form-label fw-bold">
                                                    Hình ảnh sản phẩm <span class="text-danger">*</span>
                                                </label>
                                                <input asp-for="NewProduct.Image"
                                                       type="file"
                                                       class="form-control"
                                                       accept="image/*"
                                                       onchange="previewImage(event)" />
                                                <span asp-validation-for="NewProduct.Image" class="text-danger small"></span>
                                                <div class="form-text">Chấp nhận JPG, PNG, GIF. Kích thước tối đa 5MB.</div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="preview-box" id="previewWrap">
                                                    <span id="previewPlaceholder"><i class="fas fa-image me-1"></i>Xem trước</span>
                                                    <img id="preview" src="#" alt="Preview" style="display: none;" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Thông tin cơ bản -->
                                    <div class="form-section">
                                        <div class="form-section-title"><i class="fas fa-tag me-1"></i>Thông tin cơ bản</div>
                                        <div class="row g-3">
                                            <div class="col-md-8">
                                                <label asp-for="NewProduct.Name" class="form-label fw-bold">
                                                    Tên sản phẩm <span class="text-danger">*</span>
                                                </label>
                                                <input asp-for="NewProduct.Name"
                                                       class="form-control"
                                                       placeholder="Nhập tên sản phẩm" />
                                                <span asp-validation-for="NewProduct.Name" class="text-danger small"></span>
                                            </div>

                                            <div class="col-md-4">
                                                <label asp-for="NewProduct.Price" class="form-label fw-bold">
                                                    Giá (VNĐ) <span class="text-danger">*</span>
                                                </label>
                                                <div class="input-group">
                                                    <span class="input-group-text bg-white"><i class="fas fa-dollar-sign"></i></span>
                                                    <input asp-for="NewProduct.Price"
                                                           type="number"
                                                           step="1000"
                                                           class="form-control"
                                                           placeholder="0" />
                                                </div>
                                                <span asp-validation-for="NewProduct.Price" class="text-danger small"></span>
                                            </div>

                                            <div class="col-md-8">
                                                <label asp-for="NewProduct.Description" class="form-label fw-bold">
                                                    Mô tả
                                                </label>
                                                <textarea asp-for="NewProduct.Description"
                                                          class="form-control"
                                                          rows="3"
                                                          placeholder="Nhập mô tả chi tiết"></textarea>
                                                <span asp-validation-for="NewProduct.Description" class="text-danger small"></span>
                                            </div>

                                            <div class="col-md-4">
                                                <label asp-for="NewProduct.Stock" class="form-label fw-bold">
                                                    Tồn kho <span class="text-danger">*</span>
                                                </label>
                                                <input asp-for="NewProduct.Stock"
                                                       type="number"
                                                       min="0"
                                                       class="form-control"
                                                       placeholder="0" />
                                                <span asp-validation-for="NewProduct.Stock" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Danh mục -->
                                    <div class="form-section">
                                        <div class="form-section-title"><i class="fas fa-layer-group me-1"></i>Danh mục</div>
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label asp-for="NewProduct.ParentCategoryId" class="form-label fw-bold">
                                                    Danh mục cha
                                                </label>
                                                <select asp-for="NewProduct.ParentCategoryId" id="parentCategorySelect" class="form-select">
                                                    <option value="">-- Chọn danh mục cha --</option>
                                                    @if (Model.ParentCategories != null && Model.ParentCategories.Any())
                                                    {
                                                        @foreach (var category in Model.ParentCategories)
                                                        {
                                                            <option value="@category.Value">@category.Text</option>
                                                        }
                                                    }
                                                </select>
                                            </div>

                                            <div class="col-md-6" id="childCategoryGroup" style="display: none;">
                                                <label asp-for="NewProduct.ChildCategoryId" class="form-label fw-bold">
                                                    Danh mục con <span class="text-danger">*</span>
                                                </label>
                                                <select asp-for="NewProduct.ChildCategoryId" id="childCategorySelect" class="form-select">
                                                    <option value="">-- Chọn danh mục con --</option>
                                                </select>
                                                <span asp-validation-for="NewProduct.ChildCategoryId" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Buttons -->
                                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                                        <button type="reset" class="btn btn-outline-danger rounded-pill me-2 px-4" onclick="resetForm()">
                                            <i class="fas fa-undo me-2"></i>Đặt lại
                                        </button>
                                        <button type="submit" class="btn btn-dark-soft rounded-pill px-4">
                                            <i class="fas fa-save me-2"></i>Thêm sản phẩm
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<script>
    const allCategories = @Html.Raw(Json.Serialize(Model.AllCategories != null ? Model.AllCategories.Select(c => new {
        id = c.Id,
        name = c.Name,
        parentId = c.ParentId
    }) : new object[0]));

    $(document).ready(function() {
        const parentSelect = $('#parentCategorySelect');
        const childGroup = $('#childCategoryGroup');
        const childSelect = $('#childCategorySelect');

        parentSelect.on('change', function() {
            const parentId = parseInt($(this).val());

            if (!parentId) {
                childGroup.slideUp(300);
                childSelect.val('').trigger('change');
                return;
            }

            const childCategories = allCategories.filter(c => c.parentId === parentId);

            if (childCategories.length > 0) {
                childSelect.empty();
                childSelect.append('<option value="">-- Chọn danh mục con --</option>');

                childCategories.forEach(category => {
                    childSelect.append(`<option value="${category.id}">${category.name}</option>`);
                });

                childGroup.slideDown(300);
            } else {
                childGroup.slideUp(300);
                childSelect.val('');
            }
        });
    });

    function previewImage(event) {
        const file = event.target.files[0];
        const preview = document.getElementById('preview');
        const placeholder = document.getElementById('previewPlaceholder');

        if (file) {
            if (file.size > 5 * 1024 * 1024) {
                alert('Kích thước ảnh không được vượt quá 5MB');
                event.target.value = '';
                preview.style.display = 'none';
                placeholder.style.display = 'block';
                return;
            }

            const validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/jpg'];
            if (!validTypes.includes(file.type)) {
                alert('Chỉ chấp nhận file ảnh định dạng JPG, PNG, GIF');
                event.target.value = '';
                preview.style.display = 'none';
                placeholder.style.display = 'block';
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
                placeholder.style.display = 'none';
            }
            reader.readAsDataURL(file);
        } else {
            preview.style.display = 'none';
            placeholder.style.display = 'block';
        }
    }

    function resetForm() {
        document.getElementById('preview').style.display = 'none';
        document.getElementById('previewPlaceholder').style.display = 'block';
        document.getElementById('childCategoryGroup').style.display = 'none';
        document.getElementById('parentCategorySelect').value = '';
        document.getElementById('childCategorySelect').value = '';
    }

    function toogleProductForm() {
        const section = document.getElementById('productFormSection');
        if (section.style.display === 'none') {
            section.style.display = 'block';
            section.scrollIntoView({ behavior: 'smooth' });
        } else {
            section.style.display = 'none';
        }
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}