@model ShopRegisterViewModel

@{
    ViewData["Title"] = "Sản phẩm của cửa hàng";
}

<div class="app-page">
    <div class="container py-5">

        <!-- Header -->
        <div class="page-head mb-4">
            <div class="d-flex align-items-center gap-3">
                <a asp-action="Create" class="btn btn-outline-dark rounded-circle back-btn" title="Quay lại cửa hàng">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="page-title mb-1">
                        <span class="title-icon bg-dark me-2"><i class="fas fa-box-open"></i></span>
                        Sản phẩm của tôi
                    </h1>
                    <p class="text-muted mb-0">Danh sách sản phẩm đang bán tại @Model.Shop?.Name</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Orders" class="btn btn-outline-dark btn-lg rounded-pill px-4 py-2">
                    <i class="fas fa-receipt me-2"></i>Xem đơn hàng
                </a>
                <a asp-action="Create" class="btn btn-dark-soft btn-lg rounded-pill px-4 py-2">
                    <i class="fas fa-plus me-2"></i>Thêm sản phẩm
                </a>
            </div>
        </div>

        @{ var shopProducts = Model.Products ?? new List<ProductViewModel>(); }

        @if (shopProducts.Any())
        {
            <div class="row g-3 g-md-4">
                @foreach (var product in shopProducts)
                {
                    var outOfStock = product.Stock <= 0;
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="product-card">
                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id" class="product-card-link">
                                <div class="product-img">
                                    @if (product.Stock > 0)
                                    {
                                        <span class="stock-badge stock-in"><i class="fas fa-check me-1"></i>Còn @product.Stock</span>
                                    }
                                    else
                                    {
                                        <span class="stock-badge stock-out"><i class="fas fa-times me-1"></i>Hết hàng</span>
                                    }
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name">
                                    }
                                    else
                                    {
                                        <div class="product-img-placeholder">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                </div>
                                <div class="product-info">
                                    <h6 class="product-title">@product.Name</h6>
                                    <div class="product-price">@product.Price.ToString("N0") đ</div>
                                    <div class="text-muted small">
                                        <i class="fas fa-boxes me-1"></i>Tồn kho: @product.Stock
                                    </div>
                                </div>
                            </a>
                            <div class="product-actions">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id"
                                   class="btn btn-outline-dark-soft btn-sm w-100">
                                    <i class="fas fa-eye me-1"></i>Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state text-center py-5">
                <div class="empty-icon"><i class="fas fa-box-open"></i></div>
                <h4 class="mb-1">Chưa có sản phẩm nào</h4>
                <p class="text-muted mb-3">Hãy thêm sản phẩm đầu tiên cho cửa hàng của bạn</p>
                <a asp-action="Create" class="btn btn-dark-soft rounded-pill px-4">
                    <i class="fas fa-plus me-2"></i>Thêm sản phẩm
                </a>
            </div>
        }
    </div>
</div>