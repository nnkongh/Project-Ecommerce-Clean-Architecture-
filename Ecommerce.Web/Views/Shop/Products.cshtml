@model ShopRegisterViewModel

@{
    ViewData["Title"] = "Sản phẩm của cửa hàng";
}

@section Styles {
    <style>
        .shop-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2.5rem 0;
            margin-bottom: 2rem;
        }
        .shop-card {
            border: none;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            transition: transform 0.2s;
        }
        .shop-card:hover {
            transform: translateY(-2px);
        }
    </style>
}

<div class="shop-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2 class="mb-2">
                    <i class="fas fa-box-open me-2"></i>Sản phẩm của tôi
                </h2>
                <p class="mb-0 opacity-75">Danh sách sản phẩm của @Model.Shop?.Name</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a asp-action="Create" class="btn btn-light btn-lg">
                    <i class="fas fa-arrow-left me-2"></i>Quay lại cửa hàng
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Số sản phẩm: <span class="badge bg-primary">@Model.Products.Count</span></h5>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Thêm sản phẩm
        </a>
    </div>

    @if (Model.Products.Any())
    {
        <div class="row g-3">
            @foreach (var product in Model.Products)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="shop-card card h-100">
                        <div class="position-relative">
                            <img src="@product.ImageUrl"
                                 class="card-img-top"
                                 alt="@product.Name"
                                 style="height: 180px; object-fit: cover; background: #f0f0f0;" />
                            @if (product.Stock <= 0)
                            {
                                <span class="badge bg-danger position-absolute top-0 end-0 m-2">Hết hàng</span>
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title text-truncate mb-1" title="@product.Name">@product.Name</h6>
                            <p class="text-success fw-bold mb-1">@product.Price.ToString("N0") đ</p>
                            <p class="text-muted small mb-2">
                                <i class="fas fa-boxes me-1"></i>Tồn kho: @product.Stock
                            </p>
                            <div class="mt-auto">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id"
                                   class="btn btn-sm btn-outline-primary w-100">
                                    <i class="fas fa-eye me-1"></i>Xem
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-box-open fa-3x mb-3 opacity-50"></i>
            <h6>Chưa có sản phẩm nào</h6>
            <p class="mb-0">Hãy thêm sản phẩm đầu tiên cho cửa hàng của bạn</p>
            <a asp-action="Create" class="btn btn-primary mt-3">
                <i class="fas fa-plus me-1"></i>Thêm sản phẩm
            </a>
        </div>
    }
</div>
