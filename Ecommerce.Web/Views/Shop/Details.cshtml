@using Ecommerce.Web.ViewModels
@model ShopDetailsViewModel

@{
    ViewData["Title"] = Model.Shop?.Name ?? "Cửa hàng";
}

<div class="shop-detail-page">
    <div class="container py-4 py-md-5">

        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Product")">Sản phẩm</a>
                </li>
                <li class="breadcrumb-item active">@(Model.Shop?.Name ?? "Cửa hàng")</li>
            </ol>
        </nav>

        @if (Model.Shop != null)
        {
            <div class="shop-hero mb-4">
                <div class="shop-hero-cover">
                    <div class="shop-hero-pattern"></div>
                </div>
                <div class="shop-hero-body">
                    <div class="shop-avatar">
                        @if (!string.IsNullOrEmpty(Model.Shop.ImageUrl))
                        {
                            <img src="@Model.Shop.ImageUrl" alt="@Model.Shop.Name"
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                            <div class="shop-avatar-fallback"><i class="fas fa-store"></i></div>
                        }
                        else
                        {
                            <div class="shop-avatar-fallback"><i class="fas fa-store"></i></div>
                        }
                    </div>
                    <div class="shop-hero-info">
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <h1 class="shop-header-name mb-0">@Model.Shop.Name</h1>
                            @if (Model.Shop.IsActive)
                            {
                                <span class="shop-active-badge"><i class="fas fa-circle me-1"></i>Đang hoạt động</span>
                            }
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                            <span><i class="fas fa-boxes-stacked me-1"></i>@Model.Products.Count sản phẩm</span>
                            @if (Model.Shop.CreatedAt != default)
                            {
                                <span><i class="fas fa-calendar-check me-1"></i>Tham gia từ @Model.Shop.CreatedAt.Year</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="shop-section-head mb-3">
            <div class="shop-section-title">
                <span class="shop-section-icon"><i class="fas fa-store"></i></span>
                Sản phẩm của cửa hàng
            </div>
            <span class="shop-count-chip"><i class="fas fa-box-open me-1"></i>@Model.Products.Count sản phẩm</span>
        </div>

        @if (Model.Products.Any())
        {
            <div class="row g-3 g-md-4">
                @foreach (var product in Model.Products)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="shop-product-card">
                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id" class="shop-product-link">
                                <div class="shop-product-img">
                                    @if (product.Stock > 0)
                                    {
                                        <span class="stock-chip stock-in-chip"><i class="fas fa-check"></i>Còn hàng</span>
                                    }
                                    else
                                    {
                                        <span class="stock-chip stock-out-chip"><i class="fas fa-times"></i>Hết hàng</span>
                                    }
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name">
                                    }
                                    else
                                    {
                                        <div class="shop-product-placeholder">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                    <span class="shop-product-overlay">
                                        <span class="shop-product-view"><i class="fas fa-eye me-1"></i>Xem chi tiết</span>
                                    </span>
                                </div>
                                <div class="shop-product-info">
                                    <h6 class="shop-product-title">@product.Name</h6>
                                    <div class="shop-product-price">@product.Price.ToString("N0") đ</div>
                                </div>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state text-center py-5">
                <div class="empty-icon"><i class="fas fa-box-open"></i></div>
                <h4 class="mb-1">Cửa hàng chưa có sản phẩm nào</h4>
                <p class="text-muted mb-0">Hãy quay lại sau để xem sản phẩm mới nhé!</p>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .shop-detail-page {
            background: radial-gradient(1200px 420px at 15% -50px, rgba(99,102,241,.06), transparent),
                        radial-gradient(1000px 380px at 90% -100px, rgba(239,68,68,.05), transparent),
                        #f6f7f9;
            min-height: calc(100vh - 76px);
        }

        .breadcrumb {
            font-size: .9rem;
        }

        .breadcrumb a {
            color: #6b7280;
            text-decoration: none;
        }

        .breadcrumb a:hover {
            color: #111827;
        }

        /* ===== Shop hero ===== */
        .shop-hero {
            background: #fff;
            border: 1px solid #eef0f3;
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 6px 24px rgba(17,24,39,.07);
        }

        .shop-hero-cover {
            height: 100px;
            background: linear-gradient(135deg, #1e1b4b, #111827 60%, #312e81);
            position: relative;
            overflow: hidden;
        }

        .shop-hero-pattern {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle at 20% 20%, rgba(255,255,255,.08) 0, transparent 40%),
                              radial-gradient(circle at 80% 60%, rgba(99,102,241,.25) 0, transparent 45%),
                              linear-gradient(135deg, transparent 40%, rgba(255,255,255,.03) 40%, rgba(255,255,255,.03) 42%, transparent 42%);
            background-size: 100% 100%, 100% 100%, 120px 120px;
        }

        .shop-hero-body {
            display: flex;
            align-items: center;
            gap: 1.35rem;
            padding: 1.4rem 1.6rem 1.5rem;
            flex-wrap: wrap;
        }

        .shop-avatar {
            position: relative;
            width: 96px;
            height: 96px;
            border-radius: 22px;
            overflow: hidden;
            flex-shrink: 0;
            margin-top: -3rem;
            border: 4px solid #fff;
            background: #f3f4f6;
            box-shadow: 0 10px 24px rgba(17,24,39,.18);
        }

        .shop-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .shop-avatar-fallback {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: #6b7280;
            background: linear-gradient(135deg, #eef0f3, #e5e7eb);
        }

        .shop-hero-info {
            min-width: 0;
            flex: 1;
        }

        .shop-header-name {
            font-size: 1.55rem;
            font-weight: 700;
            color: #111827;
        }

        .shop-active-badge {
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            background: #ecfdf5;
            color: #047857;
            border-radius: 999px;
            padding: .3rem .75rem;
            font-size: .76rem;
            font-weight: 600;
        }

        .shop-active-badge .fa-circle {
            font-size: .45rem;
        }

        /* ===== Section head ===== */
        .shop-section-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: .5rem;
        }

        .shop-section-title {
            display: flex;
            align-items: center;
            gap: .65rem;
            font-weight: 700;
            font-size: 1.05rem;
            color: #111827;
        }

        .shop-section-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, #111827, #1e1b4b);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: .9rem;
            box-shadow: 0 4px 10px rgba(17,24,39,.18);
        }

        .shop-count-chip {
            background: #fff;
            border: 1px solid #eef0f3;
            border-radius: 999px;
            padding: .35rem .85rem;
            font-size: .78rem;
            font-weight: 600;
            color: #6b7280;
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            box-shadow: 0 1px 4px rgba(17,24,39,.04);
        }

        /* ===== Product cards ===== */
        .shop-product-card {
            background: #fff;
            border: 1px solid #eef0f3;
            border-radius: 18px;
            overflow: hidden;
            height: 100%;
            box-shadow: 0 2px 12px rgba(17,24,39,.05);
            transition: box-shadow .25s, transform .25s;
        }

        .shop-product-card:hover {
            box-shadow: 0 14px 30px rgba(17,24,39,.11);
            transform: translateY(-4px);
        }

        .shop-product-link {
            text-decoration: none;
            color: inherit;
            display: block;
        }

        .shop-product-img {
            position: relative;
            aspect-ratio: 1 / 1;
            overflow: hidden;
            background: linear-gradient(135deg, #f8fafc, #f1f5f9);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .shop-product-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .35s ease;
        }

        .shop-product-card:hover .shop-product-img img {
            transform: scale(1.05);
        }

        .shop-product-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #9ca3af;
            font-size: 2rem;
        }

        /* ===== Stock chip ===== */
        .stock-chip {
            position: absolute;
            top: .6rem;
            right: .6rem;
            z-index: 3;
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            max-width: calc(100% - 1.2rem);
            border-radius: 999px;
            padding: .24rem .6rem;
            font-size: .68rem;
            font-weight: 600;
            line-height: 1.2;
            white-space: nowrap;
            box-shadow: 0 2px 8px rgba(17,24,39,.10);
        }

        .stock-chip i {
            font-size: .55rem;
        }

        .stock-in-chip {
            background: rgba(236,253,245,.92);
            color: #047857;
        }

        .stock-out-chip {
            background: rgba(254,242,242,.92);
            color: #b91c1c;
        }

        /* ===== Hover overlay ===== */
        .shop-product-overlay {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            padding: 1rem;
            background: linear-gradient(to top, rgba(17,24,39,.35), transparent 55%);
            opacity: 0;
            transition: opacity .25s;
            z-index: 2;
        }

        .shop-product-card:hover .shop-product-overlay {
            opacity: 1;
        }

        .shop-product-view {
            background: rgba(255,255,255,.95);
            color: #111827;
            border-radius: 999px;
            padding: .4rem .9rem;
            font-size: .74rem;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(0,0,0,.1);
        }

        /* ===== Product info ===== */
        .shop-product-info {
            padding: .9rem 1rem 1rem;
        }

        .shop-product-title {
            font-size: .92rem;
            font-weight: 600;
            color: #111827;
            margin-bottom: .4rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 2.4em;
        }

        .shop-product-price {
            font-size: 1.05rem;
            font-weight: 700;
            color: #dc2626;
        }

        /* ===== Empty state ===== */
        .empty-state {
            background: #fff;
            border: 1px dashed #d1d5db;
            border-radius: 22px;
        }

        .empty-icon {
            width: 84px;
            height: 84px;
            margin: 0 auto 1.25rem;
            border-radius: 50%;
            background: #f3f4f6;
            color: #9ca3af;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
        }

        @@media (max-width: 576px) {
            .shop-hero-body {
                flex-direction: column;
                text-align: center;
            }

            .shop-header-name {
                font-size: 1.3rem;
            }

            .shop-section-head {
                justify-content: center;
                text-align: center;
            }
        }
    </style>
}
