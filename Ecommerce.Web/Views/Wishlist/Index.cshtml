@model Ecommerce.Web.ViewModels.WishlistViewModel
@{
    ViewData["Title"] = "Danh sách yêu thích";
    var items = Model?.Items ?? new List<Ecommerce.Web.ViewModels.ItemWishlistViewModel>();
}

<div class="app-page">
    <div class="container py-5">

        <!-- Header -->
        <div class="page-head">
            <div class="d-flex align-items-center gap-3">
                <span class="title-icon title-icon-danger"><i class="fas fa-heart"></i></span>
                <div>
                    <h1 class="page-title mb-1">Danh sách yêu thích</h1>
                    <p class="text-muted mb-0">Những sản phẩm bạn đã lưu để mua sau</p>
                </div>
            </div>
            @if (items.Any())
            {
                <span class="result-count">
                    <i class="fas fa-heart text-danger me-2"></i>@items.Count sản phẩm
                </span>
            }
        </div>

        @if (!items.Any())
        {
            <div class="empty-state text-center py-5">
                <div class="empty-icon empty-icon-red"><i class="fas fa-heart-broken"></i></div>
                <h4 class="mb-1">Chưa có sản phẩm yêu thích nào</h4>
                <p class="text-muted mb-3">Khám phá sản phẩm và bấm trái tim để lưu vào đây</p>
                <a asp-controller="Category" asp-action="Index" class="btn btn-dark-soft px-4">
                    <i class="fas fa-shopping-bag me-2"></i>Mua sắm ngay
                </a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @foreach (var item in items)
                {
                    <div class="col">
                        <div class="product-card">
                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId" class="product-link">
                                <div class="product-img">
                                    <span class="heart-badge"><i class="fas fa-heart"></i></span>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.ProductName">
                                    }
                                    else
                                    {
                                        <div class="product-img-placeholder">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                </div>
                                <div class="product-info">
                                    <h6 class="product-title">@item.ProductName</h6>
                                    <div class="text-muted small">
                                        <i class="fas fa-heart text-danger me-1"></i>Yêu thích
                                    </div>
                                </div>
                            </a>
                            <div class="product-actions with-remove">
                                <form asp-controller="Wishlist" asp-action="MoveToCart" method="post" class="m-0">
                                    <input type="hidden" name="wishlistId" value="@Model.Id" />
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-add-cart w-100">
                                        <i class="fas fa-cart-plus me-2"></i>Thêm vào giỏ
                                    </button>
                                </form>
                                <form asp-controller="Wishlist" asp-action="RemoveFromWishlist" method="post" class="m-0">
                                    <input type="hidden" name="wishlistId" value="@Model.Id" />
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn-hover-remove" title="Xóa khỏi yêu thích">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
