@using Ecommerce.Domain.Shared
@using Ecommerce.Web.ViewModels
@model PagedResult<ProductViewModel>

@{
    ViewData["Title"] = "Sản phẩm";
    var sortBy = Context.Request.Query["sortBy"];
    var minPrice = Context.Request.Query["minPrice"];
    var maxPrice = Context.Request.Query["maxPrice"];
    var categoryId = Context.Request.Query["categoryId"];
    var searchTerm = Context.Request.Query["searchTerm"];

    int totalPages = Model.TotalPages;
    int currentPage = Model.PageIndex;
    string queryString(Dictionary<string, string?> overrides)
    {
        var q = new Dictionary<string, string?>
        {
            ["sortBy"] = sortBy,
            ["minPrice"] = minPrice,
            ["maxPrice"] = maxPrice,
            ["categoryId"] = categoryId,
            ["searchTerm"] = searchTerm
        };
        foreach (var kv in overrides)
            q[kv.Key] = kv.Value;
        var parts = q.Where(kv => !string.IsNullOrEmpty(kv.Value))
                     .Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}");
        return string.Join("&", parts);
    }
}

<div class="app-page">
    <div class="container py-5">

        <!-- Header -->
        <div class="page-head">
            <div class="d-flex align-items-center gap-3">
                <span class="title-icon bg-dark"><i class="fas fa-shopping-bag"></i></span>
                <div>
                    <h1 class="page-title mb-1">Sản phẩm</h1>
                    <p class="text-muted mb-0">Khám phá các sản phẩm công nghệ đang bán</p>
                </div>
            </div>
            @if (Model != null && Model.TotalItems > 0)
            {
                <span class="result-count">
                    <i class="fas fa-box me-2"></i>@Model.TotalItems sản phẩm
                </span>
            }
        </div>

        <!-- Filter & Sort -->
        <form method="get" class="filter-bar">
            <div class="row g-3 align-items-end">
                <div class="col-6 col-md-3">
                    <label class="filter-label">Sắp xếp</label>
                    <select name="sortBy" class="form-select" onchange="this.form.submit()">
                        <option value="">Mặc định</option>
                        <option value="price_asc" selected="@(sortBy == "price_asc")">Giá: Thấp đến Cao</option>
                        <option value="price_desc" selected="@(sortBy == "price_desc")">Giá: Cao đến Thấp</option>
                        <option value="name_asc" selected="@(sortBy == "name_asc")">Tên: A-Z</option>
                        <option value="name_desc" selected="@(sortBy == "name_desc")">Tên: Z-A</option>
                        <option value="newest" selected="@(sortBy == "newest")">Mới nhất</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="filter-label">Giá từ</label>
                    <input type="number" name="minPrice" class="form-control" value="@minPrice" placeholder="0" min="0" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="filter-label">Đến</label>
                    <input type="number" name="maxPrice" class="form-control" value="@maxPrice" placeholder="9.999.000" min="0" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="filter-label">Tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control" value="@searchTerm" placeholder="Tên sản phẩm..." />
                    </div>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-filter w-100">
                        <i class="fas fa-filter me-1"></i>Lọc
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-reset" title="Xóa bộ lọc">
                        <i class="fas fa-undo"></i>
                    </a>
                </div>
            </div>
        </form>

        @if (Model != null && Model.Items.Any())
        {
            <div class="result-bar">
                <span class="result-text">
                    Hiển thị <strong>@Math.Min(12, Model.Items.Count)</strong> trên <strong>@Model.TotalItems</strong> sản phẩm &mdash; trang <strong>@currentPage</strong> / <strong>@totalPages</strong>
                </span>
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <span class="result-count">
                        <i class="fas fa-search me-2"></i>Kết quả cho &ldquo;@searchTerm&rdquo;
                    </span>
                }
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                @foreach (var product in Model.Items)
                {
                    <div class="col">
                        <div class="product-card">
                            <a href="@Url.Action("Detail", "Product", new { id = product.Id })" class="product-link">
                                <div class="product-img">
                                    @if (product.Stock > 10)
                                    {
                                        <span class="stock-badge stock-in"><i class="fas fa-check me-1"></i>Còn hàng</span>
                                    }
                                    else if (product.Stock > 0)
                                    {
                                        <span class="stock-badge stock-low"><i class="fas fa-exclamation me-1"></i>Sắp hết (@product.Stock)</span>
                                    }
                                    else
                                    {
                                        <span class="stock-badge stock-out"><i class="fas fa-times me-1"></i>Hết hàng</span>
                                    }
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name">
                                    }
                                    else
                                    {
                                        <div class="product-img-placeholder">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                </div>
                                <div class="product-info">
                                    <h6 class="product-title">@product.Name</h6>
                                    @if (product.Price > 0)
                                    {
                                        <div class="product-price">@product.Price.ToString("N0") đ</div>
                                    }
                                    else
                                    {
                                        <div class="product-price price-none">Liên hệ</div>
                                    }
                                </div>
                            </a>
                            <div class="product-actions">
                                @if (product.Stock > 0)
                                {
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                        <input type="hidden" name="Id" value="@product.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-add-cart w-100">
                                            <i class="fas fa-cart-plus me-2"></i>Thêm vào giỏ
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-add-cart w-100" disabled>
                                        <i class="fas fa-times me-2"></i>Hết hàng
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <nav class="mt-5">
                    <ul class="pagination pagination-custom justify-content-center mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="?page=@(currentPage - 1)&@queryString(new Dictionary<string, string?>())">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>

                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, startPage + 4);
                            if (endPage - startPage < 4)
                                startPage = Math.Max(1, endPage - 4);
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?page=1&@queryString(new Dictionary<string, string?>())">1</a>
                            </li>
                            @if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="?page=@i&@queryString(new Dictionary<string, string?>())">@i</a>
                            </li>
                        }

                        @if (endPage < totalPages)
                        {
                            @if (endPage < totalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="?page=@totalPages&@queryString(new Dictionary<string, string?>())">@totalPages</a>
                            </li>
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="?page=@(currentPage + 1)&@queryString(new Dictionary<string, string?>())">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="empty-state text-center py-5">
                <div class="empty-icon"><i class="fas fa-box-open"></i></div>
                <h4 class="mb-1">Không tìm thấy sản phẩm phù hợp</h4>
                <p class="text-muted mb-3">Hãy thử thay đổi bộ lọc hoặc từ khóa tìm kiếm</p>
                <a href="@Url.Action("Index")" class="btn btn-dark-soft px-4">
                    <i class="fas fa-undo me-2"></i>Xem tất cả
                </a>
            </div>
        }
    </div>
</div>