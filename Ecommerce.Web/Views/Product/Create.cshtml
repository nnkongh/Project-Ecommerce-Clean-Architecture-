@model ProductViewModel

@{
    ViewData["Title"] = "Tạo sản phẩm mới";
}

@section Styles {
    <style>
        .product-page {
            background: radial-gradient(1200px 400px at 15% -50px, rgba(99,102,241,.07), transparent),
                        radial-gradient(1000px 400px at 90% -100px, rgba(239,68,68,.05), transparent),
                        #f6f7f9;
            min-height: calc(100vh - 76px);
        }

        .page-head {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.75rem;
        }

        .back-btn {
            width: 44px;
            height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111827;
        }

        .title-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            color: #fff;
            box-shadow: 0 6px 14px rgba(17,24,39,.25);
        }

        .ui-card {
            background: #fff;
            border: 1px solid #eef0f3;
            border-radius: 18px;
            box-shadow: 0 2px 10px rgba(17,24,39,.04);
            overflow: hidden;
        }

        .ui-card-head {
            background: linear-gradient(135deg, #111827, #1e1b4b);
            color: #fff;
            padding: 1.25rem 1.6rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        .ui-card-body {
            padding: 1.8rem 1.6rem;
        }

        .form-section {
            background: #f8fafc;
            border: 1px solid #eef0f3;
            border-radius: 14px;
            padding: 1.1rem 1.2rem;
            margin-bottom: 1.4rem;
        }

        .form-section-title {
            font-size: .8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #6b7280;
            margin-bottom: .9rem;
        }

        .form-control, .form-select {
            border: 1.5px solid #e5e7eb;
            border-radius: 10px;
            padding: .6rem .85rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: #312e81;
            box-shadow: 0 0 0 .2rem rgba(49,46,129,.1);
        }

        .form-label {
            font-size: .88rem;
        }

        .preview-box {
            width: 100%;
            max-width: 220px;
            height: 150px;
            margin: 0 auto;
            border-radius: 14px;
            background: #f8fafc;
            border: 1.5px dashed #d1d5db;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #9ca3af;
            overflow: hidden;
        }

        .preview-box img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .btn-dark-soft {
            background: #111827;
            color: #fff;
            font-weight: 600;
            border: none;
            border-radius: 10px;
        }

        .btn-dark-soft:hover {
            background: #312e81;
            color: #fff;
            box-shadow: 0 6px 14px rgba(17,24,39,.25);
        }
    </style>
}

<div class="product-page">
    <div class="container py-5">

        <!-- Header -->
        <div class="page-head">
            <a asp-action="Index" class="btn btn-outline-dark rounded-circle back-btn" title="Quay lại">
                <i class="fas fa-arrow-left"></i>
            </a>
            <span class="title-icon bg-dark"><i class="fas fa-plus-circle"></i></span>
            <div>
                <h1 class="page-title mb-1">Tạo sản phẩm mới</h1>
                <p class="text-muted mb-0">Thêm một sản phẩm mới lên gian hàng</p>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="ui-card">
                    <div class="ui-card-head">
                        <h5 class="mb-0">
                            <i class="fas fa-tag me-2"></i>Thông tin sản phẩm
                        </h5>
                    </div>
                    <div class="ui-card-body">
                        <form asp-action="Create" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <!-- Upload hình ảnh -->
                            <div class="form-section">
                                <div class="form-section-title"><i class="fas fa-image me-1"></i>Hình ảnh sản phẩm</div>
                                <div class="row align-items-center g-3">
                                    <div class="col-md-6">
                                        <label asp-for="Image" class="form-label fw-bold">
                                            Hình ảnh sản phẩm <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="Image"
                                               type="file"
                                               class="form-control"
                                               accept="image/*"
                                               onchange="previewImage(event)" />
                                        <span asp-validation-for="Image" class="text-danger small"></span>
                                        <div class="form-text">Chấp nhận JPG, PNG, GIF. Kích thước tối đa 5MB.</div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="preview-box" id="previewWrap">
                                            <span id="previewPlaceholder"><i class="fas fa-image me-1"></i>Xem trước</span>
                                            <img id="preview" src="#" alt="Preview" style="display: none;" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Thông tin cơ bản -->
                            <div class="form-section">
                                <div class="form-section-title"><i class="fas fa-tag me-1"></i>Thông tin cơ bản</div>
                                <div class="row g-3">
                                    <div class="col-md-8">
                                        <label asp-for="Name" class="form-label fw-bold">
                                            Tên sản phẩm <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="Name"
                                               class="form-control"
                                               placeholder="Nhập tên sản phẩm" />
                                        <span asp-validation-for="Name" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="Price" class="form-label fw-bold">
                                            Giá (VNĐ) <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="fas fa-dollar-sign"></i></span>
                                            <input asp-for="Price"
                                                   type="number"
                                                   step="1000"
                                                   class="form-control"
                                                   placeholder="0" />
                                        </div>
                                        <span asp-validation-for="Price" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-8">
                                        <label asp-for="Description" class="form-label fw-bold">
                                            Mô tả
                                        </label>
                                        <textarea asp-for="Description"
                                                  class="form-control"
                                                  rows="3"
                                                  placeholder="Nhập mô tả chi tiết"></textarea>
                                        <span asp-validation-for="Description" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="Stock" class="form-label fw-bold">
                                            Tồn kho <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="Stock"
                                               type="number"
                                               min="0"
                                               class="form-control"
                                               placeholder="0" />
                                        <span asp-validation-for="Stock" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Danh mục -->
                            <div class="form-section">
                                <div class="form-section-title"><i class="fas fa-layer-group me-1"></i>Danh mục</div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="ParentCategoryId" class="form-label fw-bold">
                                            Danh mục cha
                                        </label>
                                        <select asp-for="ParentCategoryId" id="parentCategorySelect" class="form-select">
                                            <option value="">-- Chọn danh mục cha --</option>
                                            @if (Model.ParentCategories != null && Model.ParentCategories.Any())
                                            {
                                                @foreach (var category in Model.ParentCategories)
                                                {
                                                    <option value="@category.Value">@category.Text</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <div class="col-md-6" id="childCategoryGroup" style="display: none;">
                                        <label asp-for="ChildCategoryId" class="form-label fw-bold">
                                            Danh mục con <span class="text-danger">*</span>
                                        </label>
                                        <select asp-for="ChildCategoryId" id="childCategorySelect" class="form-select">
                                            <option value="">-- Chọn danh mục con --</option>
                                        </select>
                                        <span asp-validation-for="ChildCategoryId" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Buttons -->
                            <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                    <i class="fas fa-arrow-left me-2"></i>Quay lại
                                </a>
                                <div>
                                    <button type="reset" class="btn btn-outline-danger rounded-pill px-4 me-2" onclick="resetForm()">
                                        <i class="fas fa-undo me-2"></i>Đặt lại
                                    </button>
                                    <button type="submit" class="btn btn-dark-soft rounded-pill px-4">
                                        <i class="fas fa-save me-2"></i>Tạo sản phẩm
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const allCategories = @Html.Raw(Json.Serialize(Model.AllCategories.Select(c => new {
        id = c.Id,
        name = c.Name,
        parentId = c.ParentId
    })));

    $(document).ready(function() {
        const parentSelect = $('#parentCategorySelect');
        const childGroup = $('#childCategoryGroup');
        const childSelect = $('#childCategorySelect');

        parentSelect.on('change', function() {
            const parentId = parseInt($(this).val());

            if (!parentId) {
                childGroup.slideUp(300);
                childSelect.val('').trigger('change');
                return;
            }

            const childCategories = allCategories.filter(c => c.parentId === parentId);

            if (childCategories.length > 0) {
                childSelect.empty();
                childSelect.append('<option value="">-- Chọn danh mục con --</option>');

                childCategories.forEach(category => {
                    childSelect.append(`<option value="${category.id}">${category.name}</option>`);
                });

                childGroup.slideDown(300);
            } else {
                childGroup.slideUp(300);
                childSelect.val('');
            }
        });
    });

    function previewImage(event) {
        const file = event.target.files[0];
        const preview = document.getElementById('preview');
        const placeholder = document.getElementById('previewPlaceholder');

        if (file) {
            if (file.size > 5 * 1024 * 1024) {
                alert('Kích thước ảnh không được vượt quá 5MB');
                event.target.value = '';
                preview.style.display = 'none';
                placeholder.style.display = 'block';
                return;
            }

            const validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/jpg'];
            if (!validTypes.includes(file.type)) {
                alert('Chỉ chấp nhận file ảnh định dạng JPG, PNG, GIF');
                event.target.value = '';
                preview.style.display = 'none';
                placeholder.style.display = 'block';
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
                placeholder.style.display = 'none';
            }
            reader.readAsDataURL(file);
        } else {
            preview.style.display = 'none';
            placeholder.style.display = 'block';
        }
    }

    function resetForm() {
        document.getElementById('preview').style.display = 'none';
        document.getElementById('previewPlaceholder').style.display = 'block';
        document.getElementById('childCategoryGroup').style.display = 'none';
        document.getElementById('parentCategorySelect').value = '';
        document.getElementById('childCategorySelect').value = '';
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}