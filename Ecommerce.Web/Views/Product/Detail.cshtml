@model ProductViewModel

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Product")">Sản phẩm</a>
                    </li>
                    <li class="breadcrumb-item active">@Model.Name</li>
                </ol>
            </nav>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="row">
                        <!-- Hình ảnh sản phẩm -->
                        <div class="col-md-5 mb-4 mb-md-0">
                            <div class="text-center">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl"
                                         alt="@Model.Name"
                                         class="img-fluid rounded border"
                                         style="max-height: 400px; object-fit: contain;">
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center rounded border"
                                         style="height: 400px;">
                                        <i class="fas fa-image fa-5x text-muted"></i>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Thông tin sản phẩm -->
                        <div class="col-md-7">
                            <h2 class="mb-3">@Model.Name</h2>

                            <!-- Giá -->
                            <div class="mb-4">
                                @if (Model.Price > 0)
                                {
                                    <h3 class="text-danger mb-0">
                                        @Model.Price.ToString("N0") đ
                                    </h3>
                                }
                                else
                                {
                                    <h4 class="text-muted">Chưa có giá</h4>
                                }
                            </div>

                            <!-- Mô tả -->
                            <div class="mb-4">
                                <h5 class="mb-2">
                                    <i class="fas fa-info-circle me-2 text-primary"></i>Mô tả sản phẩm
                                </h5>
                                <p class="text-muted">
                                    @if (!string.IsNullOrEmpty(Model.Description))
                                    {
                                        @Model.Description
                                    }
                                    else
                                    {
                                        <em>Chưa có mô tả</em>
                                    }
                                </p>
                            </div>

                            <!-- Tồn kho -->
                            <div class="mb-4">
                                <h6>
                                    <i class="fas fa-box me-2"></i>Tình trạng:
                                    @if (Model.Stock > 0)
                                    {
                                        <span class="badge bg-success">Còn hàng (@Model.Stock sản phẩm)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Hết hàng</span>
                                    }
                                </h6>
                            </div>

                            <hr>

                            <!-- Thêm vào giỏ hàng -->
                            @if (Model.Stock > 0)
                            {
                                <form asp-controller="Cart"
                                      asp-action="AddToCart"
                                      method="post"
                                      class="mb-4">
                                    <input type="hidden" name="Id" value="@Model.Id" />

                                    <div class="d-flex align-items-center gap-3">
                                        <div>
                                            <label class="form-label mb-1 small">Số lượng:</label>
                                            <input type="number"
                                                   name="quantity"
                                                   value="1"
                                                   min="1"
                                                   max="@Model.Stock"
                                                   class="form-control"
                                                   style="width: 100px;" />
                                        </div>
                                        <div class="mt-auto">
                                            <button type="submit" class="btn btn-primary btn-lg">
                                                <i class="fas fa-cart-plus me-2"></i>Thêm vào giỏ hàng
                                            </button>
                                        </div>
                                    </div>
                                </form>

                                <div class="d-flex gap-2">
                                    <form asp-controller="Wishlist" asp-action="AddToWishlist" method="post">
                                        <input type="hidden" name="productId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-outline-danger">
                                            <i class="fas fa-heart me-2"></i>Yêu thích
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-danger">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <strong>Sản phẩm đã hết hàng!</strong> Vui lòng quay lại sau.
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Actions (Chỉnh sửa/Xóa) -->
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <button onclick="history.back()" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại
                        </button>

                        <div class="d-flex gap-2">
                            <a href="@Url.Action("Edit", new { id = Model.Id })"
                               class="btn btn-warning">
                                <i class="fas fa-edit me-2"></i>Chỉnh sửa
                            </a>

                            <button type="button"
                                    class="btn btn-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal">
                                <i class="fas fa-trash-alt me-2"></i>Xóa
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-lg-10 mx-auto">
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex align-items-center gap-2 py-3">
                <i class="fas fa-comments text-primary"></i>
                <h5 class="mb-0">Bình luận</h5>
                <span class="badge bg-primary rounded-pill ms-auto" id="commentCount">0</span>
            </div>
            <div class="card-body">
                <div id="comments-list">
                    <div class="text-center py-5 text-muted" id="loadingComments">
                        <div class="spinner-border spinner-border-sm mb-2" role="status"></div>
                        <p class="mb-0 small">Đang tải bình luận...</p>
                    </div>
                </div>

                <hr class="my-4">

                <form id="commentForm">
                    <input type="hidden" id="productId" value="@Model.Id" />
                    <div class="d-flex gap-3">
                        <div class="flex-shrink-0">
                            <div class="comment-avatar">
                                <i class="fas fa-user"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1">
                            <div class="mb-2">
                                <textarea id="commentContent" class="form-control" rows="2" placeholder="Chia sẻ suy nghĩ của bạn về sản phẩm này..."></textarea>
                            </div>
                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary btn-sm" id="submitComment">
                                    <i class="fas fa-paper-plane me-1"></i>Gửi bình luận
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadComments();

            $('#commentForm').submit(function (e) {
                e.preventDefault();
                var content = $('#commentContent').val().trim();
                if (!content) return;

                $('#submitComment').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang gửi...');

                $.ajax({
                    url: '/comments/create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ productId: @Model.Id, content: content }),
                    success: function (response) {
                        if (response.isSuccess) {
                            $('#commentContent').val('');
                            loadComments();
                        } else {
                            alert(response.error?.message || 'Không thể thêm bình luận');
                        }
                    },
                    error: function () {
                        alert('Có lỗi xảy ra khi gửi bình luận');
                    },
                    complete: function () {
                        $('#submitComment').prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i>Gửi bình luận');
                    }
                });
            });
        });

        function loadComments() {
            $.get('/comments/product/' + @Model.Id, function (response) {
                if (response.isSuccess && response.value) {
                    var html = '';
                    var count = response.value.length;
                    $('#commentCount').text(count);

                    if (count === 0) {
                        html = '<div class="text-center py-5 text-muted">' +
                            '    <i class="far fa-comment-dots fa-3x mb-3 d-block"></i>' +
                            '    <p class="mb-0">Chưa có bình luận nào. Hãy là người đầu tiên!</p>' +
                            '</div>';
                    } else {
                        $.each(response.value, function (i, comment) {
                            var initials = (comment.userName || '?').charAt(0).toUpperCase();
                            var date = new Date(comment.createdAt);
                            var dateStr = date.toLocaleDateString('vi-VN', { year: 'numeric', month: 'short', day: 'numeric' });
                            var timeStr = date.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

                            var avatarHtml = comment.avatarUrl
                                ? '<img src="' + comment.avatarUrl + '" alt="' + escapeHtml(comment.userName || '') + '" class="comment-avatar-img" onerror="this.style.display=\'none\'">'
                                : '<div class="comment-avatar">' + initials + '</div>';

                            html += '<div class="comment-item d-flex gap-3">' +
                                '    <div class="flex-shrink-0">' +
                                        avatarHtml +
                                '    </div>' +
                                '    <div class="flex-grow-1">' +
                                '        <div class="d-flex align-items-center gap-2 mb-1">' +
                                '            <strong class="comment-author">' + (comment.userName || 'Người dùng') + '</strong>' +
                                '            <span class="text-muted small">' + dateStr + ' lúc ' + timeStr + '</span>' +
                                '            <button class="btn btn-sm btn-link text-danger p-0 ms-auto delete-comment" data-id="' + comment.id + '" title="Xóa bình luận">' +
                                '                <i class="fas fa-trash-alt"></i>' +
                                '            </button>' +
                                '        </div>' +
                                '        <p class="comment-content mb-3">' + escapeHtml(comment.content) + '</p>' +
                                '    </div>' +
                                '</div>';

                            if (i < count - 1) {
                                html += '<hr class="comment-divider">';
                            }
                        });
                    }
                    $('#comments-list').html(html);
                }
            });
        }

        function escapeHtml(text) {
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(text));
            return div.innerHTML;
        }

        $(document).on('click', '.delete-comment', function () {
            var id = $(this).data('id');
            if (!confirm('Xóa bình luận này?')) return;

            $.ajax({
                url: '/comments/' + id,
                type: 'DELETE',
                success: function (response) {
                    if (response.isSuccess) {
                        loadComments();
                    } else {
                        alert(response.error?.message || 'Không thể xóa bình luận');
                    }
                },
                error: function () {
                    alert('Có lỗi xảy ra khi xóa bình luận');
                }
            });
        });
    </script>
}

<!-- Modal xác nhận xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle me-2"></i>Xác nhận xóa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Bạn có chắc chắn muốn xóa sản phẩm <strong>@Model.Name</strong>?</p>
                <p class="text-danger small mb-0 mt-2">
                    <i class="fas fa-info-circle me-1"></i>Hành động này không thể hoàn tác!
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Hủy
                </button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-2"></i>Xóa sản phẩm
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>