@model ProductViewModel

@{
    ViewData["Title"] = Model.Name ?? "Chi tiết sản phẩm";
    var inStock = Model.Stock > 0;
}

<div class="product-detail-page">
    <div class="container py-3 py-md-4">

        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Product")">Sản phẩm</a>
                </li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
        </nav>

        <div class="row g-4">
            <div class="col-xl-10 mx-auto">

                <!-- ====== Sản phẩm ====== -->
                <div class="card border-0 rounded-4 shadow-sm product-card">
                    <div class="card-body p-3 p-lg-4">
                        <div class="row g-3 g-lg-4">
                            <!-- Hình ảnh sản phẩm -->
                            <div class="col-md-5">
                                <div class="product-image-wrap">
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <img src="@Model.ImageUrl"
                                             alt="@Model.Name"
                                             class="product-image"
                                             onerror="this.parentElement.innerHTML='<div class=&quot;product-image-placeholder&quot;><i class=&quot;fas fa-image&quot;></i></div>'" />
                                    }
                                    else
                                    {
                                        <div class="product-image-placeholder">
                                            <i class="fas fa-image"></i>
                                            <span>Chưa có ảnh</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Thông tin sản phẩm -->
                            <div class="col-md-7">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    @if (inStock)
                                    {
                                        <span class="stock-pill stock-in">
                                            <i class="fas fa-circle me-1"></i>Còn hàng (@Model.Stock sản phẩm)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="stock-pill stock-out">
                                            <i class="fas fa-circle me-1"></i>Hết hàng
                                        </span>
                                    }
                                    <span class="id-chip">Mã SP: @Model.Id</span>
                                </div>

                                <h1 class="product-name mb-1">@Model.Name</h1>

                                <div class="price-block mb-2">
                                    @if (Model.Price > 0)
                                    {
                                        <span class="price-value">@Model.Price.ToString("N0")</span>
                                        <span class="price-unit">đ</span>
                                    }
                                    else
                                    {
                                        <span class="price-none">Chưa có giá</span>
                                    }
                                </div>

                                <div class="desc-block mb-3">
                                    <div class="desc-label">
                                        <i class="fas fa-align-left me-1"></i>Mô tả sản phẩm
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.Description))
                                    {
                                        <p class="desc-text">@Model.Description</p>
                                    }
                                    else
                                    {
                                        <p class="desc-text text-muted">
                                            <em>Chưa có mô tả cho sản phẩm này.</em>
                                        </p>
                                    }
                                </div>

                                <hr class="my-3">

                                @if (inStock)
                                {
                                    <div class="purchase-row mb-2">
                                        <form asp-controller="Cart"
                                              asp-action="AddToCart"
                                              method="post"
                                              class="d-flex align-items-end gap-2">
                                            <input type="hidden" name="Id" value="@Model.Id" />

                                            <div>
                                                <label for="prodQty" class="form-label small fw-semibold text-muted mb-1">Số lượng</label>
                                                <div class="qty-stepper">
                                                    <button type="button" class="qty-btn" data-dir="-1" aria-label="Giảm">
                                                        <i class="fas fa-minus"></i>
                                                    </button>
                                                    <input type="number" id="prodQty" name="quantity"
                                                           value="1" min="1" max="@Model.Stock" class="qty-input" />
                                                    <button type="button" class="qty-btn" data-dir="1" aria-label="Tăng">
                                                        <i class="fas fa-plus"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <div>
                                                <button type="submit" class="btn btn-add-cart px-4">
                                                    <i class="fas fa-cart-plus me-2"></i>Thêm vào giỏ
                                                </button>
                                            </div>
                                        </form>

                                        <form asp-controller="Wishlist" asp-action="AddToWishlist" method="post">
                                            <input type="hidden" name="productId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-outline-danger rounded-pill px-3">
                                                <i class="far fa-heart me-2"></i>Yêu thích
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-danger rounded-3 d-flex align-items-center gap-2 mb-2">
                                        <i class="fas fa-exclamation-triangle"></i>
                                        <div>
                                            <strong>Sản phẩm đã hết hàng!</strong> Vui lòng quay lại sau.
                                        </div>
                                    </div>
                                }

                                <!-- Tin cậy -->
                                <div class="trust-row mt-3">
                                    <div class="trust-item">
                                        <i class="fas fa-truck-fast trust-icon"></i>
                                        <div class="trust-text">
                                            <strong>Giao hàng nhanh</strong>
                                            <span>Toàn quốc</span>
                                        </div>
                                    </div>
                                    <div class="trust-item">
                                        <i class="fas fa-rotate-left trust-icon"></i>
                                        <div class="trust-text">
                                            <strong>Đổi trả dễ dàng</strong>
                                            <span>Trong 7 ngày</span>
                                        </div>
                                    </div>
                                    <div class="trust-item">
                                        <i class="fas fa-shield-halved trust-icon"></i>
                                        <div class="trust-text">
                                            <strong>Hàng chính hãng</strong>
                                            <span>100% đảm bảo</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <button onclick="history.back()" class="btn btn-outline-dark rounded-pill px-4">
                                <i class="fas fa-arrow-left me-2"></i>Quay lại
                            </button>

                            <div class="d-flex gap-2 flex-wrap">
                                <a href="@Url.Action("Edit", new { id = Model.Id })"
                                   class="btn btn-warning rounded-pill px-4">
                                    <i class="fas fa-edit me-2"></i>Chỉnh sửa
                                </a>
                                <button type="button"
                                        class="btn btn-outline-danger rounded-pill px-4"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal">
                                    <i class="fas fa-trash-alt me-2"></i>Xóa
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ====== Bình luận & Đánh giá ====== -->
                <div class="card border-0 rounded-4 shadow-sm comments-card mt-4">
                    <div class="comments-head">
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <span class="comments-icon"><i class="fas fa-comments"></i></span>
                            <div class="me-auto">
                                <h2 class="h6 fw-bold text-dark mb-0">Bình luận & Đánh giá</h2>
                                <span class="text-muted small">Chia sẻ cảm nhận và trải nghiệm của bạn về sản phẩm</span>
                            </div>
                            <div class="btn-group interaction-tabs" role="group">
                                <button type="button" class="btn interaction-tab active" id="tabComments" data-tab="comments">
                                    <i class="fas fa-comments me-1"></i>Bình luận
                                    <span class="tab-count-badge ms-1" id="commentCount">0</span>
                                </button>
                                <button type="button" class="btn interaction-tab" id="tabReviews" data-tab="reviews">
                                    <i class="fas fa-star me-1"></i>Đánh giá
                                    <span class="tab-count-badge ms-1" id="reviewCount">0</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4 p-lg-5 pt-4">
                        <!-- ===== Tab Bình luận ===== -->
                        <div id="panelComments" class="interaction-panel">
                            <form id="commentForm" class="composer-form mt-2">
                                <input type="hidden" id="productId" value="@Model.Id" />
                                <div class="d-flex gap-3">
                                    <div class="composer-avatar">
                                        @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <i class="fas fa-user"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-user"></i>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="composer-box">
                                            <textarea id="commentContent" class="form-control composer-textarea" rows="2"
                                                      placeholder="Bạn nghĩ gì về sản phẩm này? Hãy viết bình luận..." maxlength="500"></textarea>
                                            <div class="composer-footer">
                                                <span class="char-count text-muted small" id="charCount">0 / 500</span>
                                                <button type="submit" class="btn btn-send-comment btn-sm rounded-pill px-4" id="submitComment" disabled>
                                                    <i class="fas fa-paper-plane me-1"></i>Gửi bình luận
                                                </button>
                                            </div>
                                        </div>
                                        <div id="commentFeedback" class="small d-none mt-2"></div>
                                    </div>
                                </div>
                            </form>

                            <hr class="my-4 comment-hr">
                            <div id="comments-list">
                                <div class="text-center py-5 text-muted">
                                    <div class="spinner-border spinner-border-sm mb-2" role="status"></div>
                                    <p class="mb-0 small">Đang tải bình luận...</p>
                                </div>
                            </div>
                        </div>

                        <!-- ===== Tab Đánh giá ===== -->
                        <div id="panelReviews" class="interaction-panel d-none">
                            <form id="reviewForm" class="composer-form mt-2">
                                <input type="hidden" id="reviewProductId" value="@Model.Id" />
                                <div class="d-flex gap-3">
                                    <div class="composer-avatar">
                                        @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <i class="fas fa-user"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-user"></i>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold text-muted mb-1">Đánh giá của bạn</label>
                                            <div class="rating-input" id="ratingStars">
                                                <i class="far fa-star rating-star" data-val="1"></i>
                                                <i class="far fa-star rating-star" data-val="2"></i>
                                                <i class="far fa-star rating-star" data-val="3"></i>
                                                <i class="far fa-star rating-star" data-val="4"></i>
                                                <i class="far fa-star rating-star" data-val="5"></i>
                                                <input type="hidden" id="ratingValue" value="0" />
                                            </div>
                                            <span class="text-muted small ms-1" id="ratingLabel">Chưa chọn</span>
                                        </div>
                                        <div class="composer-box">
                                            <textarea id="reviewContent" class="form-control composer-textarea" rows="2"
                                                      placeholder="Chia sẻ cảm nhận và đánh giá của bạn về sản phẩm..." maxlength="1000"></textarea>
                                            <div class="composer-footer">
                                                <span class="char-count text-muted small" id="reviewCharCount">0 / 1000</span>
                                                <button type="submit" class="btn btn-send-comment btn-sm rounded-pill px-4" id="submitReview" disabled>
                                                    <i class="fas fa-paper-plane me-1"></i>Gửi đánh giá
                                                </button>
                                            </div>
                                        </div>
                                        <div id="reviewFeedback" class="small d-none mt-2"></div>
                                    </div>
                                </div>
                            </form>

                            <hr class="my-4 comment-hr">
                            <div id="reviews-list">
                                <div class="text-center py-5 text-muted">
                                    <div class="spinner-border spinner-border-sm mb-2" role="status"></div>
                                    <p class="mb-0 small">Đang tải đánh giá...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .product-detail-page {
            background: radial-gradient(1200px 420px at 15% -50px, rgba(99,102,241,.06), transparent),
                        radial-gradient(1000px 380px at 90% -100px, rgba(239,68,68,.05), transparent),
                        #f6f7f9;
        }

        .product-detail-page .product-card {
            height: auto;
        }

        .breadcrumb {
            font-size: .9rem;
        }

        .breadcrumb a {
            color: #6b7280;
            text-decoration: none;
        }

        .breadcrumb a:hover {
            color: #111827;
        }

        /* Hình ảnh */
        .product-image-wrap {
            border-radius: 16px;
            background: linear-gradient(135deg, #f8fafc, #f1f5f9);
            border: 1px solid #eef0f3;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 320px;
            max-height: 100%;
            position: relative;
        }

        .product-image {
            max-height: 300px;
            width: 100%;
            object-fit: contain;
            padding: .75rem;
        }

        .product-image-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: .5rem;
            color: #9ca3af;
            font-size: 3rem;
        }

        .product-image-placeholder span {
            font-size: .9rem;
            font-weight: 500;
        }

        /* Trạng thái & tên */
        .stock-pill {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: .35rem .9rem;
            font-size: .8rem;
            font-weight: 600;
        }

        .stock-in {
            background: #ecfdf5;
            color: #047857;
        }

        .stock-in .fa-circle {
            font-size: .5rem;
        }

        .stock-out {
            background: #fef2f2;
            color: #b91c1c;
        }

        .stock-out .fa-circle {
            font-size: .5rem;
        }

        .id-chip {
            background: #eef0f3;
            color: #4b5563;
            border-radius: 999px;
            padding: .35rem .9rem;
            font-size: .78rem;
            font-weight: 600;
        }

        .product-name {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111827;
            line-height: 1.3;
        }

        /* Giá */
        .price-block {
            display: flex;
            align-items: baseline;
            gap: .25rem;
        }

        .price-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: #dc2626;
        }

        .price-unit {
            font-size: 1.05rem;
            font-weight: 700;
            color: #dc2626;
        }

        .price-none {
            font-size: 1.2rem;
            color: #9ca3af;
            font-style: italic;
        }

        /* Mô tả */
        .desc-label {
            font-size: .82rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #6b7280;
            margin-bottom: .4rem;
        }

        .desc-text {
            color: #4b5563;
            line-height: 1.55;
            white-space: pre-wrap;
            margin-bottom: 0;
            max-height: 60px;
            overflow: hidden;
        }

        /* Bộ đếm số lượng */
        .qty-stepper {
            display: inline-flex;
            align-items: center;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            overflow: hidden;
            background: #fff;
            transition: border-color .2s;
        }

        .qty-stepper:focus-within {
            border-color: #111827;
        }

        .qty-btn {
            width: 40px;
            height: 46px;
            border: none;
            background: #f8f9fa;
            color: #374151;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: .8rem;
            transition: all .2s;
        }

        .qty-btn:hover {
            background: #111827;
            color: #fff;
        }

        .qty-input {
            width: 56px;
            height: 46px;
            border: none;
            text-align: center;
            font-weight: 700;
            font-size: 1rem;
            color: #111827;
            -moz-appearance: textfield;
            appearance: textfield;
        }

        .qty-input::-webkit-outer-spin-button,
        .qty-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .qty-input:focus {
            outline: none;
        }

        /* Nút thêm giỏ hàng */
        .purchase-row {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            gap: .75rem;
        }

        .btn-add-cart {
            background: #111827;
            color: #fff;
            border: none;
            border-radius: 14px;
            font-weight: 700;
            transition: all .25s;
        }

        .btn-add-cart:hover {
            background: #312e81;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(49,46,129,.35);
        }

        /* Tin cậy */
        .trust-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: .75rem;
            background: #f8fafc;
            border: 1px dashed #d1d5db;
            border-radius: 16px;
            padding: .7rem 1rem;
        }

        .trust-item {
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .trust-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: #fff;
            border: 1px solid #eef0f3;
            color: #111827;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(17,24,39,.05);
        }

        .trust-text {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
        }

        .trust-text strong {
            font-size: .82rem;
            color: #111827;
        }

        .trust-text span {
            font-size: .73rem;
            color: #6b7280;
        }

        /* Comments */
        .comments-card {
            overflow: hidden;
            border: 1px solid #eef0f3;
        }

        .comments-head {
            background: linear-gradient(135deg, #fbfbfc, #f4f5f7);
            border-bottom: 1px solid #eceef1;
            padding: 1.1rem 1.5rem;
        }

        .comments-icon {
            width: 44px;
            height: 44px;
            border-radius: 13px;
            background: #111827;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            box-shadow: 0 5px 12px rgba(17,24,39,.25);
            flex-shrink: 0;
        }

        /* Interaction tabs (Bình luận & Đánh giá) */
        .interaction-tabs {
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            overflow: hidden;
            background: #fff;
            flex-shrink: 0;
        }

        .interaction-tab {
            background: #fff;
            border: none;
            color: #6b7280;
            font-weight: 600;
            font-size: .78rem;
            padding: .35rem .75rem;
            border-radius: 0;
            white-space: nowrap;
            transition: all .2s;
        }

        .interaction-tab:hover {
            color: #111827;
            background: #f3f4f6;
        }

        .interaction-tab.active {
            background: #111827;
            color: #fff;
        }

        .tab-count-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 17px;
            height: 17px;
            padding: 0 .35rem;
            border-radius: 999px;
            font-size: .66rem;
            font-weight: 700;
            line-height: 1;
            background: #e5e7eb;
            color: #4b5563;
        }

        .interaction-tab.active .tab-count-badge {
            background: rgba(255,255,255,.2);
            color: #fff;
        }

        .interaction-panel {
            animation: fadeIn .2s ease;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .composer-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: #eef0f3;
            color: #6b7280;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .composer-box {
            border: 2px solid #e5e7eb;
            border-radius: 14px;
            background: #fff;
            transition: border-color .2s, box-shadow .2s;
            overflow: hidden;
        }

        .composer-box:focus-within {
            border-color: #111827;
            box-shadow: 0 0 0 4px rgba(17,24,39,.06);
        }

        .composer-textarea {
            border: none;
            border-radius: 0;
            resize: none;
            padding: .75rem 1rem;
            font-size: .92rem;
        }

        .composer-textarea:focus {
            box-shadow: none;
        }

        .composer-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .5rem;
            padding: .45rem .75rem;
            background: #fafbfc;
            border-top: 1px solid #eef0f3;
        }

        .char-count {
            font-size: .76rem;
        }

        .btn-send-comment {
            background: #111827;
            color: #fff;
            border: none;
            font-weight: 600;
            transition: all .2s;
        }

        .btn-send-comment:hover:not(:disabled) {
            background: #312e81;
            color: #fff;
            box-shadow: 0 6px 14px rgba(17,24,39,.25);
        }

        .btn-send-comment:disabled {
            background: #d1d5db;
            color: #f9fafb;
            cursor: not-allowed;
        }

        .comment-hr {
            opacity: .6;
        }

        /* Reviews */
        .rating-input {
            display: inline-flex;
            align-items: center;
            gap: .15rem;
        }

        .rating-star {
            font-size: 1.6rem;
            color: #d1d5db;
            cursor: pointer;
            transition: color .15s, transform .15s;
        }

        .rating-star:hover {
            transform: scale(1.15);
        }

        .rating-star.active {
            color: #f59e0b;
        }

        .rating-star.rated {
            color: #f59e0b;
        }

        /* Review items */
        .review-stars {
            color: #f59e0b;
            font-size: .9rem;
            letter-spacing: 1px;
        }

        .review-stars .far {
            color: #d1d5db;
        }

        #reviews-list .review-item {
            padding: 1rem 0;
        }

        #reviews-list .review-avatar {
            width: 44px;
            height: 44px;
            font-size: 1rem;
        }

        #reviews-list .review-avatar-img {
            width: 44px;
            height: 44px;
        }

        #reviews-list .review-author {
            font-size: .95rem;
        }

        #reviews-list .review-content {
            background: #f8f9fa;
            border-radius: 12px 12px 12px 4px;
            padding: .8rem 1rem;
            margin-bottom: 0;
        }

        #reviews-list .delete-review {
            opacity: 0;
            transition: opacity .2s;
            padding: .2rem .45rem;
            border-radius: 8px;
        }

        #reviews-list .review-item:hover .delete-review {
            opacity: 1;
        }

        #reviews-list .comment-avatar,
        #reviews-list .comment-avatar-img {
            width: 44px;
            height: 44px;
            font-size: 1rem;
        }

        /* Comment items */
        #comments-list .comment-item {
            padding: 1rem 0;
        }

        #comments-list .comment-avatar {
            width: 44px;
            height: 44px;
            font-size: 1rem;
        }

        #comments-list .comment-avatar-img {
            width: 44px;
            height: 44px;
        }

        #comments-list .comment-author {
            font-size: .95rem;
        }

        #comments-list .comment-content {
            background: #f8f9fa;
            border-radius: 12px 12px 12px 4px;
            padding: .8rem 1rem;
            margin-bottom: 0;
        }

        #comments-list .delete-comment {
            opacity: 0;
            transition: opacity .2s;
            padding: .2rem .45rem;
            border-radius: 8px;
        }

        #comments-list .comment-item:hover .delete-comment {
            opacity: 1;
        }

        @@media (max-width: 768px) {
            .trust-row {
                grid-template-columns: 1fr;
            }

            .product-name {
                font-size: 1.35rem;
            }

            .price-value {
                font-size: 1.7rem;
            }
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            loadCommentCount();
            loadReviewCount();

            // Chuyển tab Bình luận / Đánh giá
            var commentsLoaded = false;
            var reviewsLoaded = false;

            function switchTab(tab) {
                var isComments = tab === 'comments';
                $('#tabComments').toggleClass('active', isComments);
                $('#tabReviews').toggleClass('active', !isComments);
                $('#panelComments').toggleClass('d-none', !isComments);
                $('#panelReviews').toggleClass('d-none', isComments);

                if (isComments) {
                    if (!commentsLoaded) {
                        loadComments();
                        commentsLoaded = true;
                    }
                } else {
                    if (!reviewsLoaded) {
                        loadReviews();
                        reviewsLoaded = true;
                    }
                }
            }

            $('#tabComments').on('click', function () { switchTab('comments'); });
            $('#tabReviews').on('click', function () { switchTab('reviews'); });

            // Star rating
            $('.rating-star').on('mouseenter', function () {
                var val = parseInt($(this).data('val'));
                $('.rating-star').each(function () {
                    $(this).toggleClass('active', parseInt($(this).data('val')) <= val);
                });
            }).on('mouseleave', function () {
                applyRatings();
            }).on('click', function () {
                var val = parseInt($(this).data('val'));
                $('#ratingValue').val(val);
                applyRatings();
                updateRatingLabel(val);
                checkReviewSubmitable();
            });

            function applyRatings() {
                var val = parseInt($('#ratingValue').val()) || 0;
                $('.rating-star').each(function () {
                    $(this).removeClass('active');
                    $(this).toggleClass('rated', parseInt($(this).data('val')) <= val);
                });
            }

            function updateRatingLabel(val) {
                var labels = ['Chưa chọn', 'Rất tệ', 'Tệ', 'Bình thường', 'Tốt', 'Tuyệt vời'];
                $('#ratingLabel').text(labels[val] || '');
            }

            // Character counter + enable/disable submit
            $('#reviewContent').on('input', function () {
                var len = $(this).val().length;
                $('#reviewCharCount').text(len + ' / 1000');
                checkReviewSubmitable();
            });

            function checkReviewSubmitable() {
                var hasContent = $('#reviewContent').val().trim().length > 0;
                var hasRating = parseInt($('#ratingValue').val()) > 0;
                $('#submitReview').prop('disabled', !(hasContent && hasRating));
            }

            $('#reviewForm').submit(function (e) {
                e.preventDefault();
                var content = $('#reviewContent').val().trim();
                var rating = parseInt($('#ratingValue').val());
                if (!content || !rating) return;

                $('#submitReview').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang gửi...');
                showReviewFeedback(null);

                $.ajax({
                    url: '/reviews/create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ productId: @Model.Id, content: content, rating: rating }),
                    success: function (response) {
                        if (response.isSuccess) {
                            $('#reviewContent').val('');
                            $('#ratingValue').val(0);
                            $('#reviewCharCount').text('0 / 1000');
                            $('.rating-star').removeClass('active').removeClass('rated');
                            updateRatingLabel(0);
                            $('#submitReview').prop('disabled', true);
                            showReviewFeedback('<i class="fas fa-check-circle me-1"></i>Đánh giá đã được gửi thành công!', true);
                            loadReviewCount();
                            if (reviewsLoaded) {
                                loadReviews();
                            }
                        } else {
                            $('#submitReview').prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i>Gửi đánh giá');
                            alert(response.error?.message || 'Không thể thêm đánh giá');
                        }
                    },
                    error: function () {
                        $('#submitReview').prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i>Gửi đánh giá');
                        alert('Có lỗi xảy ra khi gửi đánh giá');
                    }
                });
            });

            // Quantity stepper
            function clampQty(input) {
                var min = parseInt(input.min) || 1;
                var max = parseInt(input.max) || 99;
                var v = parseInt(input.value) || 1;
                input.value = Math.min(max, Math.max(min, v));
            }

            $('#prodQty').on('change', function () {
                clampQty(this);
            });

            $('.qty-btn').on('click', function () {
                var input = $('#prodQty')[0];
                var v = parseInt(input.value) || 1;
                v += parseInt($(this).data('dir'));
                input.value = v;
                clampQty(input);
            });

            // Character counter + enable/disable submit
            $('#commentContent').on('input', function () {
                var len = $(this).val().length;
                $('#charCount').text(len + ' / 500');
                $('#submitComment').prop('disabled', $(this).val().trim().length === 0);
            });

            $('#commentForm').submit(function (e) {
                e.preventDefault();
                var content = $('#commentContent').val().trim();
                if (!content) return;

                $('#submitComment').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang gửi...');
                showFeedback(null);

                $.ajax({
                    url: '/comments/create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ productId: @Model.Id, content: content }),
                    success: function (response) {
                        if (response.isSuccess) {
                            $('#commentContent').val('');
                            $('#charCount').text('0 / 500');
                            showFeedback('<i class="fas fa-check-circle me-1"></i>Bình luận đã được đăng thành công!', true);
                            loadComments();
                        } else {
                            $('#submitComment').prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i>Gửi bình luận');
                            alert(response.error?.message || 'Không thể thêm bình luận');
                        }
                    },
                    error: function () {
                        $('#submitComment').prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i>Gửi bình luận');
                        alert('Có lỗi xảy ra khi gửi bình luận');
                    },
                    complete: function () {
                        if ($('#commentContent').val().trim()) {
                            $('#submitComment').prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i>Gửi bình luận');
                        }
                    }
                });
            });
        });

        function showFeedback(html, isSuccess) {
            var box = $('#commentFeedback');
            if (!html) {
                box.addClass('d-none').removeClass('text-success').removeClass('text-danger');
                return;
            }
            box.removeClass('d-none')
               .toggleClass('text-success', !!isSuccess)
               .toggleClass('text-danger', !isSuccess)
               .html(html);
            if (isSuccess) {
                setTimeout(function () {
                    box.addClass('d-none');
                }, 3500);
            }
        }

        function loadCommentCount() {
            $.get('/comments/product/' + @Model.Id, function (response) {
                if (response.isSuccess && response.value) {
                    var count = response.value.length;
                    $('#commentCount').text(count);
                }
            });
        }

        function loadComments() {
            $.get('/comments/product/' + @Model.Id, function (response) {
                if (response.isSuccess && response.value) {
                    var html = '';
                    var count = response.value.length;
                    $('#commentCount').text(count);

                    if (count === 0) {
                        html = '<div class="text-center py-5 text-muted">' +
                            '    <div class="empty-comments-icon mx-auto mb-3"><i class="far fa-comment-dots"></i></div>' +
                            '    <h6 class="fw-bold text-dark mb-1">Chưa có bình luận nào</h6>' +
                            '    <p class="mb-0">Hãy là người đầu tiên chia sẻ cảm nhận về sản phẩm này!</p>' +
                            '</div>';
                    } else {
                        $.each(response.value, function (i, comment) {
                            var initials = (comment.userName || '?').charAt(0).toUpperCase();
                            var date = new Date(comment.createdAt);
                            var dateStr = date.toLocaleDateString('vi-VN', { day: 'numeric', month: 'short', year: 'numeric' });
                            var timeStr = date.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

                            var avatarHtml = comment.avatarUrl
                                ? '<img src="' + comment.avatarUrl + '" alt="' + escapeHtml(comment.userName || '') + '" class="comment-avatar-img" onerror="this.style.display=\'none\'">'
                                : '<div class="comment-avatar">' + initials + '</div>';

                            html += '<div class="comment-item d-flex gap-3">' +
                                '    <div class="flex-shrink-0">' + avatarHtml + '</div>' +
                                '    <div class="flex-grow-1">' +
                                '        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">' +
                                '            <strong class="comment-author">' + escapeHtml(comment.userName || 'Người dùng') + '</strong>' +
                                '            <span class="text-muted small"><i class="far fa-clock me-1"></i>' + dateStr + ' lúc ' + timeStr + '</span>' +
                                '            <button class="btn btn-link text-danger p-0 ms-auto delete-comment" data-id="' + comment.id + '" title="Xóa bình luận">' +
                                '                <i class="fas fa-trash-alt"></i>' +
                                '            </button>' +
                                '        </div>' +
                                '        <p class="comment-content mb-3">' + escapeHtml(comment.content) + '</p>' +
                                '    </div>' +
                                '</div>';

                            if (i < count - 1) {
                                html += '<hr class="comment-divider">';
                            }
                        });
                    }
                    $('#comments-list').html(html);
                }
            });
        }

        function escapeHtml(text) {
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(text));
            return div.innerHTML;
        }

        $(document).on('click', '.delete-comment', function () {
            var id = $(this).data('id');
            if (!confirm('Xóa bình luận này?')) return;

            $.ajax({
                url: '/comments/' + id,
                type: 'DELETE',
                success: function (response) {
                    if (response.isSuccess) {
                        loadComments();
                    } else {
                        alert(response.error?.message || 'Không thể xóa bình luận');
                    }
                },
                error: function () {
                    alert('Có lỗi xảy ra khi xóa bình luận');
                }
            });
        });

        function showReviewFeedback(html, isSuccess) {
            var box = $('#reviewFeedback');
            if (!html) {
                box.addClass('d-none').removeClass('text-success').removeClass('text-danger');
                return;
            }
            box.removeClass('d-none')
               .toggleClass('text-success', !!isSuccess)
               .toggleClass('text-danger', !isSuccess)
               .html(html);
            if (isSuccess) {
                setTimeout(function () {
                    box.addClass('d-none');
                }, 3500);
            }
        }

        function loadReviewCount() {
            $.get('/reviews/product/' + @Model.Id, function (response) {
                if (response.isSuccess && response.value) {
                    var count = response.value.length;
                    $('#reviewCount').text(count);
                }
            });
        }

        function renderStars(rating) {
            var html = '';
            for (var i = 1; i <= 5; i++) {
                html += '<i class="' + (i <= rating ? 'fas' : 'far') + ' fa-star"></i>';
            }
            return html;
        }

        function loadReviews() {
            $.get('/reviews/product/' + @Model.Id, function (response) {
                if (response.isSuccess && response.value) {
                    var html = '';
                    var count = response.value.length;
                    $('#reviewCount').text(count);

                    if (count === 0) {
                        html = '<div class="text-center py-5 text-muted">' +
                            '    <div class="empty-comments-icon mx-auto mb-3"><i class="far fa-star"></i></div>' +
                            '    <h6 class="fw-bold text-dark mb-1">Chưa có đánh giá nào</h6>' +
                            '    <p class="mb-0">Hãy là người đầu tiên chia sẻ đánh giá về sản phẩm này!</p>' +
                            '</div>';
                    } else {
                        $.each(response.value, function (i, review) {
                            var initials = (review.userName || '?').charAt(0).toUpperCase();
                            var date = new Date(review.createdAt);
                            var dateStr = date.toLocaleDateString('vi-VN', { day: 'numeric', month: 'short', year: 'numeric' });
                            var timeStr = date.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

                            var avatarHtml = review.avatarUrl
                                ? '<img src="' + review.avatarUrl + '" alt="' + escapeHtml(review.userName || '') + '" class="comment-avatar-img review-avatar-img" onerror="this.style.display=\'none\'">'
                                : '<div class="comment-avatar review-avatar">' + initials + '</div>';

                            var starsHtml = '<span class="review-stars">' + renderStars(review.rating) + '</span>';

                            html += '<div class="review-item d-flex gap-3">' +
                                '    <div class="flex-shrink-0">' + avatarHtml + '</div>' +
                                '    <div class="flex-grow-1">' +
                                '        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">' +
                                '            <strong class="review-author">' + escapeHtml(review.userName || 'Người dùng') + '</strong>' +
                                '            <span>' + starsHtml + '</span>' +
                                '            <span class="text-muted small"><i class="far fa-clock me-1"></i>' + dateStr + ' lúc ' + timeStr + '</span>' +
                                '            <button class="btn btn-link text-danger p-0 ms-auto delete-review" data-id="' + review.id + '" title="Xóa đánh giá">' +
                                '                <i class="fas fa-trash-alt"></i>' +
                                '            </button>' +
                                '        </div>' +
                                '        <p class="review-content mb-3">' + escapeHtml(review.content) + '</p>' +
                                '    </div>' +
                                '</div>';

                            if (i < count - 1) {
                                html += '<hr class="comment-divider">';
                            }
                        });
                    }
                    $('#reviews-list').html(html);
                }
            });
        }

        $(document).on('click', '.delete-review', function () {
            var id = $(this).data('id');
            if (!confirm('Xóa đánh giá này?')) return;

            $.ajax({
                url: '/reviews/' + id,
                type: 'DELETE',
                success: function (response) {
                    if (response.isSuccess) {
                        loadReviewCount();
                        loadReviews();
                    } else {
                        alert(response.error?.message || 'Không thể xóa đánh giá');
                    }
                },
                error: function () {
                    alert('Có lỗi xảy ra khi xóa đánh giá');
                }
            });
        });
    </script>
}

<!-- Modal xác nhận xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 overflow-hidden">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle me-2"></i>Xác nhận xóa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Bạn có chắc chắn muốn xóa sản phẩm <strong>@Model.Name</strong>?</p>
                <p class="text-danger small mb-0 mt-2">
                    <i class="fas fa-info-circle me-1"></i>Hành động này không thể hoàn tác!
                </p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Hủy
                </button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        <i class="fas fa-trash-alt me-2"></i>Xóa sản phẩm
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>