@model List<Ecommerce.Web.ViewModels.NotificationViewModel>
@{
    ViewData["Title"] = "Thông báo";
    var notifications = Model ?? new List<Ecommerce.Web.ViewModels.NotificationViewModel>();
    var unreadCount = notifications.Count(n => !n.IsRead);
}

<div class="app-page">
    <div class="container py-5">

        <!-- Header -->
        <div class="page-head">
            <div class="d-flex align-items-center gap-3">
                <span class="title-icon" style="background: linear-gradient(135deg, #6366f1, #a855f7); box-shadow: 0 6px 14px rgba(99,102,241,.3);"><i class="fas fa-bell"></i></span>
                <div>
                    <h1 class="page-title mb-1">Thông báo</h1>
                    <p class="text-muted mb-0">Cập nhật về đơn hàng và hoạt động tài khoản</p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (unreadCount > 0)
                {
                    <span class="badge-count">
                        <i class="fas fa-envelope text-indigo me-2"></i>@unreadCount chưa đọc
                    </span>
                    <form asp-controller="Notification" asp-action="MarkAsRead" method="post" class="m-0">
                        <button type="submit" class="btn btn-dark-soft px-3">
                            <i class="fas fa-check-double me-1"></i>Đánh dấu đã đọc tất cả
                        </button>
                    </form>
                }
            </div>
        </div>

        @if (!notifications.Any())
        {
            <div class="empty-state text-center py-5">
                <div class="empty-icon empty-icon-red"><i class="fas fa-bell-slash"></i></div>
                <h4 class="mb-1">Chưa có thông báo nào</h4>
                <p class="text-muted mb-3">Bạn sẽ nhận được thông báo về trạng thái đơn hàng ở đây</p>
                <a asp-controller="Category" asp-action="Index" class="btn btn-dark-soft px-4">
                    <i class="fas fa-shopping-bag me-2"></i>Mua sắm ngay
                </a>
            </div>
        }
        else
        {
            <div class="notification-list">
                @foreach (var item in notifications)
                {
                    <div class="notification-item @(item.IsRead ? "is-read" : "")">
                        <div class="notification-icon">
                            <i class="fas fa-bell"></i>
                        </div>
                        <div class="notification-body">
                            <div class="notification-title">@item.Title</div>
                            <div class="notification-desc">@item.Description</div>
                            <div class="notification-time">
                                <i class="fas fa-clock me-1"></i>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                        @if (!item.IsRead)
                        {
                            <form asp-controller="Notification" asp-action="MarkAsRead" method="post" class="notification-read-form m-0">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="notification-read-btn" title="Đánh dấu đã đọc">
                                    <i class="fas fa-check"></i>
                                </button>
                            </form>
                            <span class="unread-dot"></span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
